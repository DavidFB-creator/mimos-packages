# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-grub-theme
pkgver=0.3.0.beta.4
pkgrel=1
pkgdesc='MimOS boot menu theme for GRUB'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
# grub is a hard dependency because this package is only meaningful once a GRUB
# menu exists, and the scriptlet edits /etc/default/grub, which grub owns.
depends=('grub')
# The artwork is committed rather than generated at package time on purpose.
# Building it needs rsvg-convert, ImageMagick, grub-mkfont and the real Inter
# face; requiring all four on the ISO build host to produce files that never
# change would trade a reproducible input for a fragile one. Regenerate with
# scripts/generate-grub-theme.py when the palette or the artwork moves.
source=(
  'LICENSE'
  'mimos-grub-theme.install'
  'theme.txt'
  'background.png'
  'inter-menu.pf2'
  'menu_c.png'
  'menu_e.png'
  'menu_n.png'
  'menu_ne.png'
  'menu_nw.png'
  'menu_s.png'
  'menu_se.png'
  'menu_sw.png'
  'menu_w.png'
  'select_c.png'
  'select_e.png'
  'select_n.png'
  'select_ne.png'
  'select_nw.png'
  'select_s.png'
  'select_se.png'
  'select_sw.png'
  'select_w.png'
)
