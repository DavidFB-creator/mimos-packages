# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-grub-theme
pkgver=0.9.0.beta.4
pkgrel=1
pkgdesc='MimOS boot menu theme for GRUB'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
# grub is a hard dependency because this package is only meaningful once a GRUB
# menu exists, and because /etc/default/grub.d is only read by grub-mkconfig.
depends=('grub')
# gettext for msgfmt: the boot-message catalogues are compiled here rather than
# committed as .mo, because a .mo is a build artefact of the .po beside it and
# committing both is how the two drift apart.
makedepends=('gettext')
# The artwork is committed rather than generated at package time on purpose.
# Building it needs rsvg-convert, ImageMagick, grub-mkfont and the real Inter
# face; requiring all four on the ISO build host to produce files that never
# change would trade a reproducible input for a fragile one. Regenerate with
# scripts/generate-grub-theme.py when the palette or the artwork moves.
source=(
  'LICENSE'
  'mimos-grub-theme.install'
  '10-mimos.cfg'
  'mensajes-arranque.es.po'
  'mensajes-arranque.en.po'
  'theme.txt'
  'background.png'
  'menu.pf2'
  'icon-mimos.png'
  'icon-windows.png'
  'select_c.png'
  'select_e.png'
  'select_n.png'
  'select_ne.png'
  'select_nw.png'
  'select_s.png'
  'select_se.png'
  'select_sw.png'
  'select_w.png'
)
sha256sums=('97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf'
            '6304e8c0c705515b2541dd64b0672dc9b85ebe71f9d81beae696d051261eec4a'
