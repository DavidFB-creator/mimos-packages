            'ff09e0c3f37b96177e945ec03b4636afe84d7e78ed6788dd7b1d25b27c9e0e36'
            '639acc715059ee0efa153623ec8291ca9a94626c961ae34e922312d3ebd52dec'
            'f6eeecd13a8ea08dfa3804519eaead8f28da492b96358ec67249025b72810f2f'
            'ff09e0c3f37b96177e945ec03b4636afe84d7e78ed6788dd7b1d25b27c9e0e36'
            'abb44adb67f273462bfb3e909352c93369b17da945a35eca35a653539f54c6dc'
            '81f13407761c1d9335e50d9534d5e1818028642f2dbef3b729003d522adb96fe'
            '9da54e895cc4eccd9211958a5346b3378fbb859487eb4d92dc965495f8699a48')
backup=('etc/default/grub.d/10-mimos.cfg')
install='mimos-grub-theme.install'

package() {
  local dest="${pkgdir}/usr/share/grub/themes/mimos"

  install -Dm644 theme.txt "${dest}/theme.txt"
  install -Dm644 background.png "${dest}/background.png"
  install -Dm644 menu.pf2 "${dest}/menu.pf2"

  # The per-entry icons. GRUB looks for icons/<class>.png and draws nothing,
  # silently, when a name misses -- so the directory name is as load-bearing
  # as the file names.
  install -Dm644 icon-mimos.png "${dest}/icons/mimos.png"
  install -Dm644 icon-windows.png "${dest}/icons/windows.png"

  local piece
  for piece in c e n ne nw s se sw w; do
    install -Dm644 "select_${piece}.png" "${dest}/select_${piece}.png"
  done

  # The drop-in, marked backup so a person who edits it does not lose the edit
  # on the next upgrade -- it is configuration, not artwork.
  install -Dm644 10-mimos.cfg "${pkgdir}/etc/default/grub.d/10-mimos.cfg"

  # The boot-message catalogues, under a locale name grub does not own. Using
  # es@mimos rather than es is what keeps this out of the grub package's way:
  # /usr/share/locale/es/LC_MESSAGES/grub.mo is theirs, and two packages cannot
  # own one path.
  local idioma
  for idioma in es en; do
    msgfmt --output-file "${srcdir}/grub-${idioma}.mo" \
      "mensajes-arranque.${idioma}.po"
    install -Dm644 "${srcdir}/grub-${idioma}.mo" \
      "${pkgdir}/usr/share/locale/${idioma}@mimos/LC_MESSAGES/grub.mo"
  done

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
