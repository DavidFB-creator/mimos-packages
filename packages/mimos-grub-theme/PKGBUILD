install='mimos-grub-theme.install'

package() {
  local dest="${pkgdir}/usr/share/grub/themes/mimos"

  install -Dm644 theme.txt "${dest}/theme.txt"
  install -Dm644 background.png "${dest}/background.png"
  install -Dm644 inter-menu.pf2 "${dest}/inter-menu.pf2"

  local slice
  for slice in menu select; do
    local piece
    for piece in c e n ne nw s se sw w; do
      install -Dm644 "${slice}_${piece}.png" "${dest}/${slice}_${piece}.png"
    done
  done

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
