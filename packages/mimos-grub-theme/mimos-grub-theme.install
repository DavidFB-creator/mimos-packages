# Retire the block earlier versions of this package appended to
# /etc/default/grub.
#
# Up to 0.6.0.beta.1-1 the settings lived in a marker-delimited block appended
# to that file, because there seemed to be nowhere else to put them. There is:
# grub-mkconfig sources /etc/default/grub.d/*.cfg after the main file, so the
# package now ships 10-mimos.cfg and owns it outright. Everything the old block
# set is in that file, plus the console background it never had.
#
# The block has to go all the same. Leaving it would not break anything -- the
# drop-in is sourced afterwards and wins -- but it would leave two places
# stating the same settings, one of them unowned and permanently stale, and the
# next person to change a value would find the wrong one first.
#
# Only a block we wrote is removed, matched by our own markers, and nothing
# else in that file is read or rewritten.

mimos_theme_marker_begin='# >>> mimos grub theme >>>'
mimos_theme_marker_end='# <<< mimos grub theme <<<'
mimos_theme_default='/etc/default/grub'

_mimos_retire_legacy_block() {
  [[ -f "${mimos_theme_default}" ]] || return 0
  grep -Fq "${mimos_theme_marker_begin}" "${mimos_theme_default}" 2>/dev/null ||
    return 0

  local trimmed
  trimmed="$(mktemp)"
  sed "/^${mimos_theme_marker_begin}\$/,/^${mimos_theme_marker_end}\$/d" \
    "${mimos_theme_default}" > "${trimmed}"
  # Written through `cat` rather than moved into place: /etc/default/grub
  # belongs to the grub package, and replacing the inode would take its
  # ownership and permissions with it.
  cat "${trimmed}" > "${mimos_theme_default}"
  rm -f -- "${trimmed}"
  printf '  The old MimOS block has been removed from %s;\n' \
    "${mimos_theme_default}"
  printf '  the settings now live in /etc/default/grub.d/10-mimos.cfg.\n'
}

_mimos_say_regenerate() {
  printf '  MimOS boot menu configured (/etc/default/grub.d/10-mimos.cfg).\n'
  printf '  Run grub-mkconfig -o /boot/grub/grub.cfg to apply it.\n'
}

post_install() {
  _mimos_retire_legacy_block
  _mimos_say_regenerate
}

post_upgrade() {
  _mimos_retire_legacy_block
  _mimos_say_regenerate
}

post_remove() {
  # The drop-in went with the package, so the menu is already back to stock at
  # the next grub-mkconfig. Nothing to undo -- say so rather than leaving the
  # person wondering whether a file was left behind.
  printf '  The MimOS boot menu settings are gone.\n'
  printf '  Run grub-mkconfig -o /boot/grub/grub.cfg to rebuild the menu.\n'
}
