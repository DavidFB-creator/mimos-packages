# MimOS boot messages, Catalan (ADR-159).
#
# The Catalan twin of mensajes-arranque.es.po: the same four replacements,
# compiled into /usr/share/locale/ca@mimos/LC_MESSAGES/grub.mo and reached
# when /etc/locale.conf names a Catalan LANG -- the drop-in derives the
# language from it, so an installation made in Catalan picks this file with
# nothing else changing. Everything not named here falls through to GRUB's
# own ca catalogue.
#
# The two loading lines are a single space on purpose, exactly as in the
# Spanish file: an empty msgstr means "untranslated" and would put the
# English line back.
msgid ""
msgstr ""
"Project-Id-Version: mimos-grub-theme\n"
"Language: ca\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Loading Linux %s ..."
msgstr " "

msgid "Loading initial ramdisk ..."
msgstr " "

msgid "%s, with Linux %s"
msgstr "MimOS"

msgid "%s, with Linux %s (fallback initramfs)"
msgstr "MimOS (arrencada de reserva)"

msgid "Advanced options for %s"
msgstr "Opcions avançades"
