pkgbase = mimos-actualizador
	pkgdesc = MimOS update notifier and ordered updater
	pkgver = 0.8.0.beta.3
	pkgrel = 1
	url = https://github.com/DavidFB-creator/MimOS
	arch = x86_64
	license = MIT
	makedepends = gcc
	makedepends = pkgconf
	depends = bash
	depends = qt6-declarative
	depends = pacman-contrib
	depends = fakeroot
	depends = archlinux-contrib
	optdepends = paru: update AUR packages
	optdepends = flatpak: update Flatpak applications
	optdepends = ghostty: show the update in the MimOS terminal
	optdepends = konsole: fallback terminal for the update
	optdepends = snap-pac: snapshot every update so it can be undone
	options = !debug
	source = mimos-actualizador
	source = mimos-actualizar
	source = mimos-buscar-actualizaciones
	source = Tray.qml
	source = actualizador-main.cpp
	source = mimos-actualizador.desktop
	source = mimos-actualizador-autostart.desktop
