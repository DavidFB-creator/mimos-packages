#!/usr/bin/env bash
# shellcheck disable=SC2016
# Updates MimOS, in David's order: official repositories, then the AUR, then
# Flatpaks.
#
# **The order is a safety property, not a preference.** The official set is
# what the system's integrity depends on, and it must be applied whole before
# anything else runs. An AUR package builds against the libraries the official
# set provides, so building first and upgrading afterwards is how people get a
# binary linked to a library that no longer exists. And a failing AUR build
# must never leave the official upgrade half-applied -- so if the first step
# fails, nothing after it runs.
#
# This runs in a visible terminal on purpose. pacman asks real questions --
# replacements, conflicts, .pacnew files -- and it asks for a password. A
# graphical updater that hides those questions either answers them for you or
# hangs, and both are worse than showing the person what is happening to their
# computer.
#
# Snapshots (ADR-102) sit underneath every step here: snap-pac brackets each
# pacman transaction, so an update that breaks the machine is recoverable from
# the boot menu. That is what made shipping the AUR defensible at all.
# See ADR-104.
set -Eeuo pipefail

# Translations (ADR-159). Every string a person reads below is written in
# Spanish and looked up in mimos-actualizador.mo for the session's language; a missing
# catalogue means Spanish. eval_gettext keeps $variables inside the msgid so
# the translator can move them, which is why SC2016 is off for this file.
export TEXTDOMAIN=mimos-actualizador
export TEXTDOMAINDIR="${mimos_test_textdomaindir:-/usr/share/locale}"
# shellcheck disable=SC1091
. gettext.sh

titulo() {
  printf '\n\033[1;38;2;255;111;174m  %s\033[0m\n\n' "$*"
}

aviso() {
  printf '\n\033[1;38;2;241;213;138m  %s\033[0m\n\n' "$*"
}

pausa_final() {
  printf '\n  %s' "$(gettext 'Pulsa Intro para cerrar esta ventana.')"
  read -r _ || true
}

titulo "$(gettext 'Actualizando MimOS')"
gettext '  Cada paso deja una instantánea, así que si algo sale mal
  puedes volver atrás desde el menú de arranque.'
printf '\n'

# --- 1. official repositories ------------------------------------------
titulo "$(gettext '1 de 3 · Repositorios oficiales y MimOS')"
if ! sudo pacman -Syu; then
  aviso "$(gettext 'La actualización oficial no ha terminado bien.')"
  gettext '  No se continúa con el AUR ni con Flatpak: instalar sobre una
  actualización a medias es peor que no actualizar.'
  printf '\n'
  pausa_final
  exit 1
fi

# --- 2. the AUR --------------------------------------------------------
titulo "$(gettext '2 de 3 · AUR')"
if ! command -v paru > /dev/null 2>&1; then
  printf '  %s\n' "$(gettext 'paru no está instalado; se omite.')"
elif ! paru -Sua; then
  # Deliberately not fatal. The official system is already updated and
  # consistent at this point; one AUR package that fails to build is that
  # package's problem, and stopping here would leave Flatpak unattended for
  # no gain.
  aviso "$(gettext 'Algún paquete del AUR no se ha podido actualizar.')"
  gettext '  El sistema oficial sí está al día. El AUR es software sin
  revisar: que uno falle no rompe tu MimOS.'
  printf '\n'
fi

# --- 3. Flatpak --------------------------------------------------------
titulo "$(gettext '3 de 3 · Flatpak')"
if ! command -v flatpak > /dev/null 2>&1; then
  printf '  %s\n' "$(gettext 'Flatpak no está instalado; se omite.')"
elif ! flatpak update; then
  aviso "$(gettext 'Alguna aplicación Flatpak no se ha podido actualizar.')"
fi

# --- what is still running the old code --------------------------------
# An update is not finished when pacman exits. A service that was already
# running keeps its old libraries mapped until it restarts, so a machine can
# be fully patched and still be running the thing that was just fixed. Nobody
# is told this by default.
#
# The idea and — more to the point — the exclusion list come from arch-update
# by Robin Candau (GPL-3.0, https://github.com/Antiz96/arch-update), read on
# 2026-08-10. **The exclusions are the expensive part**: restarting the
# display manager pulls the desktop out from under the person while they are
# watching this very window, so every login manager is left out on purpose.
# `checkservices` itself is Arch's own: extra/archlinux-contrib, verified
# with `pacman -F` rather than assumed — the first check used `pacman -Ql`,
# which only answers for installed packages and said it did not exist.
#
# MimOS lists and does not offer to restart. This runs in a terminal the
# person is watching, not a TUI, and a numbered menu that restarts system
# services is a different kind of program with a different kind of accident.
# Telling someone exactly what to type is enough.
if command -v checkservices > /dev/null 2>&1; then
  gestores_de_sesion=(
    sddm.service gdm.service plasmalogin.service lightdm.service
    lxdm.service slim.service xdm.service greetd.service nodm.service
    ly.service lemurs.service
  )
  excluir=()
  for gestor in "${gestores_de_sesion[@]}"; do
    excluir+=(-i "${gestor}")
  done

  servicios="$(sudo checkservices -F -P -R "${excluir[@]}" 2> /dev/null |
    grep -o "[A-Za-z0-9@._-]*\.service" | sort -u || true)"

  if [[ -n "${servicios}" ]]; then
    titulo "$(gettext 'Servicios que siguen con la versión antigua')"
    printf '%s\n' "${servicios}" | sed 's/^/    /'
    printf '\n  %s\n' "$(gettext 'Siguen funcionando con el código de antes de actualizar.')"
    printf '  %s\n\n' "$(gettext 'Para reiniciarlos:')"
    printf '    sudo systemctl restart %s\n\n' "${servicios//$'\n'/ }"
    printf '  %s\n' "$(gettext 'Reiniciar el ordenador también sirve, y es lo más sencillo.')"
  fi
fi

titulo "$(gettext 'Listo')"
pausa_final
