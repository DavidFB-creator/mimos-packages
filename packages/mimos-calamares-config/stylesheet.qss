/* Generated by scripts/generate-calamares-style.py -- do not edit.
 *
 * Every colour is a role from the mimos-claro palette theme. Editing this file by
 * hand is how it came to hold six near-misses and three invented colours, one of
 * them a single digit away from a real palette value. Change palette.json and
 * regenerate; `make check` fails if this file and the palette disagree.
 */

/* The base is windowBackgroundAlternate, not windowBackground.
 *
 * Measured rather than judged by eye: the first attempt used windowBackground
 * and 227,709 of the window's pixels came out #F8F4FF -- 248,244,255, which is
 * 97% luminance and reads as white however lavender its name is. The palette's
 * light theme is built for a desktop, where near-white is right; the installer
 * is a first impression and wants a step more colour. Both are palette roles,
 * so neither is invented. */
QWidget {
    color: #221B3A;
    background-color: #FFD3E5;
    font-family: "Inter";
    font-size: 10pt;
}

/* Only the window carries the gradient. Putting it on #viewManagerStack too
 * drew a second, differently-shaded panel inside the first, which is the edge
 * that showed up as a box behind the welcome title. */
#mainApp {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #FFEFF6,
        stop: 1 #FFD3E5);
}

/* The rule above sets a background on QWidget, and every widget inherits it --
 * including labels, which then paint an opaque rectangle each. Over a gradient
 * those rectangles read as ugly boxes behind every heading, and in the sidebar
 * they left a pale band under the logo. Text and containers sit on whatever is
 * behind them instead. */
QLabel,
#viewManagerStack,
#viewManager {
    background: transparent;
}

/* No rule for the requirements panel.
 *
 * Calamares computes a salmon #FFBFBF for it, which is not a colour MimOS owns,
 * and the obvious fix was to override #requirementsChecker and
 * #resultsExplanation. Two reasons not to. It did not work -- the salmon is
 * painted by the list items, not those containers -- and it put a red border
 * around a plain informational sentence, which is worse than the shade clash.
 *
 * More to the point, that panel only appears when requirements FAIL. The local
 * preview runs unprivileged with no target disk so it always fails there, which
 * is what made the panel look like the main event; the exact-image captures show
 * that area empty. Styling it further means iterating on a screen almost nobody
 * sees, guided by an artefact of the harness. */

/* A near-black tooltip over a light installer is the palette's desktop choice
 * and it lands badly here. Same information, same family, light. */
QToolTip {
    color: #221B3A;
    background-color: #FFEFF6;
    border: 1px solid #FF6FAE;
    border-radius: 6px;
    padding: 4px 8px;
}

/* The page content ran to the very edge of the window: at 1024px the welcome
 * title finished a pixel from the border. Object names come from Calamares
 * itself (setObjectName) rather than being guessed at. */
#viewManagerStack {
    padding: 8px 24px;
}

/* The symbol drew a white box on the sidebar. Not the SVG's doing -- it paints
 * no background at all -- but the widget inheriting the window colour. */
#logoApp,
#welcomeLogo {
    background-color: transparent;
}

/* Sidebar steps had no vertical rhythm and read as a dense block. */
#sidebarMenuApp {
    padding: 12px 0;
}

#sidebarMenuApp QLabel {
    padding: 9px 16px;
}

/* Secondary controls: present, without competing with the navigation buttons.
 * No min-width here. The clipped "Acerca d" that suggested one turned out to be
 * an artefact of the preview running with -d, which adds a second button beside
 * it inside the sidebar's width; production has only this one and it fits. */
/* These sit inside the sidebar, so the rule that paints its children purple
 * reaches them too and left purple text on purple. Given their own ground back,
 * after that rule rather than before it. */
#sidebarApp #aboutButton,
#sidebarApp #debugButton {
    font-size: 9pt;
    padding: 4px 10px;
    color: #221B3A;
    background-color: #FFD3E5;
    border: 1px solid #FF6FAE;
    border-radius: 8px;
}

#summaryTitle,
#summaryItemTitle {
    font-weight: 600;
}

QPushButton {
    min-height: 34px;
    padding: 6px 14px;
    border: 1px solid #FF6FAE;
    border-radius: 8px;
    color: #221B3A;
    background-color: #FFD3E5;
}

QPushButton:hover {
    background-color: #FFEFF6;
}

QPushButton:focus {
    border: 2px solid #FF6FAE;
}

QPushButton:disabled {
    color: #7A5670;
}

/* The primary action, in Besito with Noche on it -- the same pink-with-dark-text
 * pairing the website uses for its download button.
 *
 * The object name is "view-button-next". The hand-written stylesheet this
 * replaced targeted #nextButton and #doneButton, and NEITHER EXISTS ANYWHERE IN
 * CALAMARES: the rule had never styled anything, and the contrast pair measured
 * for it was measuring dead code. Names here come from
 * src/calamares/CalamaresWindow.cpp. */
QPushButton#view-button-next {
    color: #221B3A;
    background-color: #FF6FAE;
    border-color: #FF6FAE;
    font-weight: 600;
}

QPushButton#view-button-next:disabled {
    color: #7A5670;
    background-color: #FFD3E5;
    border-color: #7A5670;
}

QLineEdit,
QComboBox,
QSpinBox {
    min-height: 30px;
    padding: 4px 8px;
    border: 1px solid #7A5670;
    border-radius: 6px;
    color: #221B3A;
    background-color: #FFEFF6;
}

/* Data views -- the partition table above all. Without these rules the QSS
 * stops at the table's edge and everything inside is stock Breeze: a white
 * body, a white header row and a blue selection, which is most of the pixels
 * on the partitions page. The 0.5.0-beta.1 manual-partitioning capture shows
 * exactly that. Typed as QAbstractItemView so the combo popups and the
 * summary lists inherit the same ground; the selection is the Besito-with-
 * Noche pair the rest of the system uses (ADR-092). */
QAbstractItemView {
    color: #221B3A;
    background-color: #FFEFF6;
    alternate-background-color: #FFD3E5;
    border: 1px solid #7A5670;
    border-radius: 6px;
    selection-color: #221B3A;
    selection-background-color: #FF6FAE;
}

QHeaderView::section {
    color: #221B3A;
    background-color: #FFD3E5;
    border: none;
    padding: 4px 8px;
    font-weight: 600;
}

/* The sidebar's step list is itself a QAbstractItemView (Calamares'
 * ProgressTreeView), so the rule above reached it and framed the violet step
 * column with a hairline border -- visible in the first preview of this
 * stylesheet and pointed out by David before anything shipped. branding.desc
 * owns every colour in that list; the stylesheet's only job there is to stay
 * out of the way. */
#sidebarApp QAbstractItemView {
    background: transparent;
    border: none;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 2px solid #FF6FAE;
}

/* The container, not just the menu. branding.desc paints the step list, but
 * this box sits behind the logo -- leaving it a different colour is what put a
 * dark band above a purple sidebar. */
/* focusDecoration, deliberately the same violet branding.desc uses for
 * SidebarBackground. This rule used to say selectionBackground, which WAS that
 * violet -- until ADR-092 moved the selection to canonical Besito and the
 * container silently followed it to hot pink while the step list stayed
 * violet: a pink frame around purple steps that nobody chose. The 0.5.0-beta.1
 * captures show that clash; the 0.4 image validated the all-violet sidebar
 * with this same dark-surface lockup. */
/* Wide enough for the horizontal lockup to read. At the default ~180px the
 * 979x400 master scaled down to a squashed thumbnail; the heart lost its shape
 * before the wordmark became legible. */
#sidebarApp,
#sidebarApp > QWidget {
    background-color: #5B3BE0;
}

#sidebarApp {
    min-width: 252px;
}

/* The users page is inside a QScrollArea now (calamares patch 0005), and the
 * QWidget rule above gives it an opaque windowBackgroundAlternate. That is the
 * same "second, differently-shaded panel" the #mainApp comment describes, one
 * level deeper: a flat rectangle covering the gradient exactly where the page
 * sits.
 *
 * Addressed by object name rather than by type. How far a QScrollArea selector
 * reaches depends on which widgets honour a stylesheet background -- a QFrame
 * does, a plain QWidget subclass does not without WA_StyledBackground -- and the
 * viewport is a child of the scroll area while the page is a child of the
 * viewport. Rather than settle that from the class hierarchy and find out from a
 * composed image, patch 0005 names the widget and this addresses the name.
 *
 * Three exact names, not a descendant sweep. "#usersScrollArea QWidget" would
 * have been shorter and would also have hit every QLineEdit on the page: an id
 * plus a type out-specifies the bare QLineEdit rule below, so the credential
 * fields would have lost the background that makes them look like fields. The
 * containers are named one by one instead -- the scroll area, its direct children
 * (the viewport, and the scrollbars, which set the same value again themselves),
 * and the page, whose object name uic takes from page_usersetup.ui. */
#usersScrollArea,
#usersScrollArea > QWidget,
#Page_UserSetup {
    background: transparent;
    border: none;
}

/* A scrollbar is now something a user actually sees on this page, so it gets the
 * palette rather than the Breeze default that showed up as a grey column with
 * arrow buttons against a purple sidebar in the 200% capture. Arrow buttons are
 * given zero height: they are a 16px target apiece and the drag handle is the
 * control that matters. */
QScrollBar:vertical {
    width: 12px;
    margin: 0;
    background: transparent;
}

QScrollBar:horizontal {
    height: 12px;
    margin: 0;
    background: transparent;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #FF6FAE;
    border-radius: 6px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #FF6FAE;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* On the sidebar the handle sits on the violet ground, where hoverDecoration is
 * too close to find. tooltipForeground is the same near-white the step labels
 * use (branding.desc SidebarText); selectionForeground stopped being that white
 * when ADR-092 made the selection Besito-with-Noche, so naming it here would
 * paint a near-black handle on a dark violet column. */
#sidebarApp QScrollBar::handle:vertical,
#sidebarApp QScrollBar::handle:horizontal {
    background-color: #F8F4FF;
}
