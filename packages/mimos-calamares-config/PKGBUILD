pkgname=mimos-calamares-config
pkgver=0.5.0.beta.4
pkgrel=1
pkgdesc='Disconnected Calamares configuration and branding for MimOS'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
depends=('calamares=3.4.2' 'mimos-branding' 'qt6-declarative')
source=(
  'settings.conf'
  'branding.desc'
  'show.qml'
  'stylesheet.qss'
  'welcome.conf'
  'locale.conf'
  'keyboard.conf'
  'partition.conf'
  'users.conf'
  'mount.conf'
  'unpackfs.conf'
  'shellprocess@initialize-keyring.conf'
  'shellprocess@default-face.conf'
  'shellprocess@remove-broadcom-wl.conf'
  'machineid.conf'
  'luksbootkeyfile.conf'
  'fstab.conf'
  'initcpiocfg.conf'
  'grubcfg.conf'
  'initcpio.conf'
  'packages.conf'
  'removeuser.conf'
  'displaymanager.conf'
  'services-systemd.conf'
  'bootloader.conf'
  'umount.conf'
  'finished.conf'
  'LICENSE'
)
