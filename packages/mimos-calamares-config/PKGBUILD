package() {
  local module_config

  install -Dm644 settings.conf "${pkgdir}/etc/calamares/settings.conf"
  for module_config in \
    welcome locale keyboard partition users mount unpackfs \
    shellprocess@initialize-keyring shellprocess@default-face \
    shellprocess@remove-broadcom-wl machineid \
    luksbootkeyfile fstab initcpiocfg grubcfg initcpio packages removeuser \
    displaymanager services-systemd bootloader umount finished; do
    install -Dm644 "${module_config}.conf" \
      "${pkgdir}/etc/calamares/modules/${module_config}.conf"
  done

  install -Dm644 branding.desc \
    "${pkgdir}/usr/share/calamares/branding/mimos/branding.desc"
  install -Dm644 show.qml \
    "${pkgdir}/usr/share/calamares/branding/mimos/show.qml"
  install -Dm644 stylesheet.qss \
    "${pkgdir}/usr/share/calamares/branding/mimos/stylesheet.qss"
  ln -s ../../../mimos/branding/mimos-symbol.svg \
    "${pkgdir}/usr/share/calamares/branding/mimos/mimos-symbol.svg"
  # MIMI herself, for the product icon and the slideshow. The file ships in
  # mimos-branding (a hard dependency), so this link cannot dangle on an
  # installed system.
  ln -s ../../../mimos/branding/mimi.svg \
    "${pkgdir}/usr/share/calamares/branding/mimos/mimi.svg"
  ln -s ../../../mimos/branding/mimos-logo-horizontal.svg \
    "${pkgdir}/usr/share/calamares/branding/mimos/mimos-logo-horizontal.svg"
  # The sidebar sits on Abrazo-dark, which is neither surface the other
  # horizontal masters declare, and the tagline fails contrast there. See
  # palette.json and ADR-065.
  ln -s ../../../mimos/branding/mimos-logo-horizontal-dark-no-tagline.svg     "${pkgdir}/usr/share/calamares/branding/mimos/mimos-logo-horizontal-dark-no-tagline.svg"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
