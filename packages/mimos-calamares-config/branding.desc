---
componentName: mimos
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px,640px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
  productName: MimOS
  shortProductName: MimOS
  version: 0.4.0-beta.1
  shortVersion: 0.4
  versionedName: 'MimOS 0.4 "Arrumaco" Beta 1'
  shortVersionedName: MimOS 0.4
  bootloaderEntryName: MimOS
  productUrl: ''
  supportUrl: ''
  knownIssuesUrl: ''
  releaseNotesUrl: ''
  donateUrl: ''

images:
  # MIMI, not the abstract symbol: this icon backs the About dialog and the
  # window identity, which render large enough for the face to live (the
  # measured 32 px floor). The panel and menus take their icon from the
  # desktop entry's size-aware mimos-instalador, not from here. See ADR-089.
  productIcon: mimi.svg
  productLogo: mimos-logo-horizontal-dark-no-tagline.svg
  productWelcome: mimos-logo-horizontal.svg

style:
  SidebarBackground: '#5B3BE0'
  SidebarText: '#FFFFFF'
  SidebarTextCurrent: '#221B3A'
  SidebarBackgroundCurrent: '#FF6FAE'

slideshow: show.qml
slideshowAPI: 2

uploadServer:
  type: none
  url: ''
  sizeLimit: 0
