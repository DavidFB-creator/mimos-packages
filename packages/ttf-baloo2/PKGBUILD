# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>
#
# Baloo 2 is the typeface the MimOS brand is set in, on the website and in the
# packaged lockups. It is not in the Arch repositories -- `baloo` there is
# KDE's file indexer, an unrelated project with a colliding name -- and the
# AUR is not an option for this project, so it is built here from a reviewed
# in-tree recipe like Calamares.
#
# The source is the canonical Google Fonts repository, pinned to a commit
# rather than to a branch, so the bytes cannot change under us:
#   google/fonts @ c13390277dfb1fcc7415d84ef7ef9cfc1e52f8c1 (2026-03-03)
#
# Verified before this recipe was written, because a font package that ships
# the wrong family is indistinguishable from one that works until something
# renders:
#   * the file declares family "Baloo 2" -- `inter-font` ships
#     InterVariable.ttf whose family is "Baloo 2"'s counterpart "Inter
#     Variable", which is exactly the ADR-047 trap;
#   * it carries named instances Regular, Medium, SemiBold, Bold, ExtraBold;
#   * weight 800 is reachable through the variable axis: rendering the same
#     text at 400 and at 800 differs by 9821 pixels, and rendering it in
#     Baloo 2 differs from an unknown family by 6038, so the weight applies
#     and the family really resolves.

pkgname=ttf-baloo2
pkgver=20260303
pkgrel=1
pkgdesc='Baloo 2, the MimOS brand typeface (variable, weight axis)'
arch=('any')
url='https://fonts.google.com/specimen/Baloo+2'
license=('OFL-1.1')
_commit=c13390277dfb1fcc7415d84ef7ef9cfc1e52f8c1
source=(
  "Baloo2-wght-${pkgver}.ttf::https://raw.githubusercontent.com/google/fonts/${_commit}/ofl/baloo2/Baloo2%5Bwght%5D.ttf"
  "OFL-${pkgver}.txt::https://raw.githubusercontent.com/google/fonts/${_commit}/ofl/baloo2/OFL.txt"
)
sha256sums=('d47a6852548059b1db49a1319d06d499d546c3fa2237cf9eee9c43c8abb025c2'
            'ad09b05dc8bc678c9daf7c4c5f7ef1f55e5726127f4330b2e98e40b9dffcb860')

package() {
  # The bracketed upstream name is restored on disk: fontconfig does not care,
  # but it is the name every Google Fonts tool expects for a variable font and
  # keeping it makes the file recognisable to anyone who goes looking.
  install -Dm644 "Baloo2-wght-${pkgver}.ttf" \
    "${pkgdir}/usr/share/fonts/baloo2/Baloo2[wght].ttf"
  install -Dm644 "OFL-${pkgver}.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/OFL.txt"
}
