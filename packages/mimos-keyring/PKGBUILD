# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>
#
# Ships the MimOS package-signing public key and registers it with pacman's
# keyring, so an installed system can verify MimOS packages it downloads.
#
# Carries MimOS Package Signing <packages@mimoslinux.org>, RSA 4096, created
# 2026-07-27, fingerprint 77E1176695E14EBFA3A03B93CE5181401267126E.
#
# mimos.gpg holds public key material only. tests/shell/tst_keyring_staging.sh
# fails if anything resembling a private key ever appears in this directory.
#
# See KEY.md for the order in which the repository and the [mimos] section
# must follow: the section ships last, because the Live matrix runs
# `pacman -Syu` and a configured repository that does not answer fails it.

pkgname=mimos-keyring
pkgver=0.5.0.beta.4
pkgrel=1
pkgdesc='MimOS package signing keys'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
depends=('pacman')
install="${pkgname}.install"
source=('mimos.gpg' 'mimos-trusted' 'mimos-revoked' 'LICENSE')
sha256sums=('a64f9c7c3061029d1994192f932f2f407b0c23bea87e495f88d6dee1819a870a'
            '42de32fef8362b0647e130a2d2964c446e8646b78daad577ca1a3a0b8b090904'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
            '97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf')

package() {
  install -Dm644 mimos.gpg \
    "${pkgdir}/usr/share/pacman/keyrings/mimos.gpg"
  install -Dm644 mimos-trusted \
    "${pkgdir}/usr/share/pacman/keyrings/mimos-trusted"
  install -Dm644 mimos-revoked \
    "${pkgdir}/usr/share/pacman/keyrings/mimos-revoked"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
