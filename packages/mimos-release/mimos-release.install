# Wire the MimOS package channel into pacman.conf.
#
# Owning /etc/pacman.conf was the first choice and was abandoned on evidence:
# the file belongs to the pacman package, no pristine copy is available offline
# to base ours on, and the obvious source -- the build host's own file -- is
# customised, so shipping it would push one developer's settings to every user.
#
# So this appends, and only ever appends. It is additive, idempotent, guarded
# by a marker, and removes exactly what it added. It never edits a line it did
# not write.

mimos_marker_begin='# >>> mimos channel >>>'
mimos_marker_end='# <<< mimos channel <<<'
mimos_conf='/etc/pacman.conf'

_mimos_add_channel() {
  # Already present: do nothing. An upgrade must not append a second copy, and
  # a user who edited the block keeps their edit.
  if grep -Fq "${mimos_marker_begin}" "${mimos_conf}" 2>/dev/null; then
    return 0
  fi

  cat >> "${mimos_conf}" <<EOF

${mimos_marker_begin}
# Added by mimos-release. Remove this block, or the package, to opt out.
# SigLevel is deliberate: without a verified signature this repository must not
# be used, and TrustAll over a network would remove the only protection signing
# provides.
[mimos]
SigLevel = Required TrustedOnly
Include = /etc/pacman.d/mimos-mirrorlist
${mimos_marker_end}
EOF
  printf '  MimOS package channel added to %s\n' "${mimos_conf}"
}

_mimos_remove_channel() {
  grep -Fq "${mimos_marker_begin}" "${mimos_conf}" 2>/dev/null || return 0
  local trimmed
  trimmed="$(mktemp)"
  # Delete only between the markers, inclusive, and leave every other line
  # exactly as it was.
  sed "/^${mimos_marker_begin}\$/,/^${mimos_marker_end}\$/d" \
    "${mimos_conf}" > "${trimmed}"
  cat "${trimmed}" > "${mimos_conf}"
  rm -f -- "${trimmed}"
  printf '  MimOS package channel removed from %s\n' "${mimos_conf}"
}

# Let GRUB find the other operating systems on the disk.
#
# MimOS ships os-prober and never enables it, so a dual-boot installation could
# leave Windows intact on disk and absent from the boot menu -- which for the
# person using the machine is indistinguishable from having lost it. GRUB has
# disabled os-prober by default since 2.06 for security reasons, and Arch's
# /etc/default/grub carries the switch commented out.
#
# Calamares cannot do this for us: its bootloader module runs grub-mkconfig and
# exposes no option for os-prober. Checked in the 3.4.2 source, not assumed.
#
# The same reasoning as the channel above applies to the file. /etc/default/grub
# belongs to the grub package, so this appends rather than edits. The file is
# sourced as a shell script and the last assignment wins, so an appended line is
# effective without touching the commented-out one -- and a user who sets their
# own value below this block still wins.
#
# Why this reaches an installed system at all: MimOS installs by copying the Live
# filesystem with unpackfs, so the file this scriptlet edits during the image
# build is the file the target receives, and Calamares runs the bootloader module
# afterwards.
# The installed boot menu also has to say which system it boots.
#
# Measured on the first physical installation: the menu read "Arch Linux" beside
# "Windows Boot Manager". The MimOS boot menus in scripts/configure.sh brand the
# ISO's own menus and nothing else -- the GRUB that Calamares writes to the disk
# is generated by grub-mkconfig from the grub package's own templates. Nothing
# caught it because every previous installation used the whole disk, where GRUB
# boots straight through and the menu is never seen. It takes a second system on
# the disk for anyone to look at it.
#
# /etc/grub.d/10_linux builds the title as "${GRUB_DISTRIBUTOR} Linux", read from
# the real grub 2:2.14-1 template rather than remembered, so this yields
# "MimOS Linux" and a --class mimos on the entry. GRUB offers no way to drop the
# trailing word without patching a file the grub package owns, and "MimOS Linux"
# is the same shape as every other distribution's entry.
#
# This does not affect the EFI directory name. Calamares always passes
# --bootloader-id, from efiBootloaderId or the branding entry name; grub-install
# only falls back to GRUB_DISTRIBUTOR when no id is given, which never happens
# here. Checked in the 3.4.2 bootloader module.
mimos_grub_marker_begin='# >>> mimos grub >>>'
mimos_grub_marker_end='# <<< mimos grub <<<'
# The block was called "mimos os-prober" before it carried the distributor name.
# An upgrade has to recognise the old one, or it would return early on the marker
# it already wrote and the new setting would never arrive.
mimos_grub_legacy_begin='# >>> mimos os-prober >>>'
mimos_grub_legacy_end='# <<< mimos os-prober <<<'
mimos_grub_default='/etc/default/grub'

_mimos_strip_grub_block() {
  local begin="$1" end="$2" trimmed
  grep -Fq "${begin}" "${mimos_grub_default}" 2>/dev/null || return 1
  trimmed="$(mktemp)"
  sed "/^${begin}\$/,/^${end}\$/d" "${mimos_grub_default}" > "${trimmed}"
  cat "${trimmed}" > "${mimos_grub_default}"
  rm -f -- "${trimmed}"
  return 0
}

_mimos_configure_grub() {
  [[ -f "${mimos_grub_default}" ]] || return 0

  if _mimos_strip_grub_block \
    "${mimos_grub_legacy_begin}" "${mimos_grub_legacy_end}"; then
    printf '  replacing the previous MimOS GRUB block in %s\n' \
      "${mimos_grub_default}"
  elif grep -Fq "${mimos_grub_marker_begin}" "${mimos_grub_default}" 2>/dev/null
  then
    # Already current: do nothing, so an upgrade cannot append a second copy and
    # a user who edited the block keeps their edit.
    return 0
  fi

  cat >> "${mimos_grub_default}" <<EOF

${mimos_grub_marker_begin}
# Added by mimos-release. Remove this block, or the package, to opt out.
# Without this, an installation that keeps another operating system on the disk
# would not offer it in the boot menu. os-prober is shipped for this purpose.
GRUB_DISABLE_OS_PROBER=false
# The boot menu of an installed MimOS said "Arch Linux" until this was set.
GRUB_DISTRIBUTOR="MimOS"
${mimos_grub_marker_end}
EOF
  printf '  GRUB will look for other systems and name this one (%s)\n' \
    "${mimos_grub_default}"
}

_mimos_unconfigure_grub() {
  [[ -f "${mimos_grub_default}" ]] || return 0
  _mimos_strip_grub_block \
    "${mimos_grub_marker_begin}" "${mimos_grub_marker_end}" ||
    _mimos_strip_grub_block \
      "${mimos_grub_legacy_begin}" "${mimos_grub_legacy_end}" ||
    return 0
  printf '  MimOS block removed from %s\n' "${mimos_grub_default}"
}

post_install() {
  _mimos_add_channel
  _mimos_configure_grub
}

post_upgrade() {
  _mimos_add_channel
  _mimos_configure_grub
}

pre_remove() {
  _mimos_remove_channel
  _mimos_unconfigure_grub
}
