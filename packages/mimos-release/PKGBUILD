# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-release
pkgver=1.0.0
pkgrel=1
pkgdesc='Release identity for MimOS'
arch=('any')
# zram-generator, from extra, is what reads mimos-zram.conf. Shipping the
# configuration without the generator would leave a file that looks like a
# setting and does nothing -- this project's most-repeated defect, and one it
# has a rule about.
depends=('zram-generator')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
source=('mimos' 'mimos-release' 'mimos-mirrorlist' 'mimos-release.install'
        'mimos-remove-unneeded-broadcom-wl' 'mimos-configure-snapshots'
        'mimos-restaurar' 'mimos-tiempos.conf' 'mimos-diario.conf'
        'mimos-zram.conf' 'mimos-volcados.conf' 'mimos-resolucion.conf'
        'mimos-zona-publica.xml' 'mimos.preset' 'LICENSE')
sha256sums=('de1e12ae066dd23266f26ca45c97c095ada20a0fd7fe1f07c11e046886acf0ae'
            '3732a0361778d588ba119b14513a388d08be9d98e0116faf724944e1bc53a0a4'
            '324741c65ad2bdafe4d9c45f15ea24e57c6e48ae31bd3f89e08c7e5df482f8ae'
            '5de8f0799a2f140dd7c8bf85e32eca418b9baba8db7066e34f1ebdd691abf0b1'
            '56ed0532501f5d37e4de26236f83d9a5036f3c208d6d6782d16de9f6b3199c61'
            '7db6a468036531c7911140c1428b6817d8f5b5a03efbb7e69361bbf06dd89c58'
            '6b886dd91dc114e77be8fc71ee7e05d804503a66f7a4fc13ec55f1996f9d2c00'
            'b52979482c1e760bdd277328a264f67c6733019367ca4e5489f921dea1e14737'
            '30455c5ad440d7a8ce26ce52c03f0ce712dea9f0e7db81c9afe61512fdc9e131'
            '186d7f8541dd04e1b75fa842ac0904123458e7eb5cb45637c0567071a417e9d3'
            'a8b337c6b50d5a2ebceb5245e49e2eceea19d5071da1588628d86accdeb2620a'
            '6bc6f9b50a4f4e98ee498128b864250fc5aa72ea31d15e8bf6b7299e1f611b31'
            '9112cd0adee99f020ba7d9b8903d0fe43f138cc69fbee1f3866f742d6da7adc8'
            '285f17276226611efbd68b5986283e165be8105d6468c4686244f68bd5dd989d'
            '97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf')
# The mirrorlist is configuration: a user who edits it must not have it
# overwritten by the next update, and pacman must leave a .pacnew instead.
# The firewall zone is configuration twice over: firewall-cmd itself
# rewrites it when the user changes rules, so clobbering it on upgrade
# would undo their firewall.
backup=('etc/pacman.d/mimos-mirrorlist'
        'etc/firewalld/zones/public.xml')
# The channel section is appended to /etc/pacman.conf by the scriptlet rather
# than shipped as a file, because that file belongs to pacman and no pristine
# copy exists to base ours on. See the install file for the full reasoning.
install='mimos-release.install'

package() {
  install -Dm644 mimos-release "${pkgdir}/etc/mimos-release"
  # The friendly front door: `mimos ayuda` instead of three hyphenated
  # names. It delegates to commands other packages own and checks they
  # exist first, so the Live session gets an explanation rather than
  # bash's command-not-found. See ADR-142.
  install -Dm755 mimos "${pkgdir}/usr/bin/mimos"
  # Every mirror is commented out, and no [mimos] section exists in the image
  # to read them. Shipping the list before the repository answers would fail
  # the Live matrix's `pacman -Syu`. See packages/mimos-keyring/KEY.md.
  install -Dm644 mimos-mirrorlist \
    "${pkgdir}/etc/pacman.d/mimos-mirrorlist"
  # Calamares runs this in the target after `packages`; it also serves an
  # existing installation by hand. It removes the broadcom-wl blob only when
  # no Broadcom wireless PCI device exists, because the blob's class-wide
  # alias loads it on every machine and taints the kernel. See ADR-097.
  install -Dm755 mimos-remove-unneeded-broadcom-wl \
    "${pkgdir}/usr/lib/mimos/mimos-remove-unneeded-broadcom-wl"
  # Calamares runs this in the target before the bootloader, so the first
  # grub.cfg already lists the installation's own snapshot. See ADR-102.
  install -Dm755 mimos-configure-snapshots \
    "${pkgdir}/usr/lib/mimos/mimos-configure-snapshots"
  # This one is public: it is the command a person runs when their system is
  # broken, so it lives on PATH and speaks Spanish.
  install -Dm755 mimos-restaurar "${pkgdir}/usr/bin/mimos-restaurar"

  # System defaults that a person feels rather than reads. All four are
  # drop-ins under /usr/lib, so a user who disagrees overrides them in /etc
  # and nothing here fights back. See ADR-124 for what each one is worth and
  # where the values came from.
  install -Dm644 mimos-tiempos.conf     "${pkgdir}/usr/lib/systemd/system.conf.d/00-mimos-tiempos.conf"
  install -Dm644 mimos-diario.conf     "${pkgdir}/usr/lib/systemd/journald.conf.d/00-mimos-diario.conf"
  install -Dm644 mimos-zram.conf     "${pkgdir}/usr/lib/systemd/zram-generator.conf"
  install -Dm644 mimos-volcados.conf     "${pkgdir}/usr/lib/tmpfiles.d/mimos-volcados.conf"

  # LLMNR apagado, mDNS encendido. Encontrado por la pasada de seguridad
  # sobre un sistema instalado, no leyendo configuraciones. Ver ADR-137.
  install -Dm644 mimos-resolucion.conf     "${pkgdir}/usr/lib/systemd/resolved.conf.d/00-mimos-resolucion.conf"

  # The public firewall zone with exactly one addition: kdeconnect, so a
  # phone can pair. /etc overrides /usr/lib in firewalld, and this is the
  # same file firewall-cmd writes, hence the backup= entry. See ADR-151.
  install -Dm644 mimos-zona-publica.xml \
    "${pkgdir}/etc/firewalld/zones/public.xml"

  # MimOS's own preset policy: NetworkManager runs the network here, so
  # systemd-networkd is disabled by policy and a first boot stops printing two
  # red errors about units MimOS masks on purpose. 10- so it sorts above
  # systemd's own 90-systemd.preset, which says the opposite. See ADR-135.
  install -Dm644 mimos.preset \
    "${pkgdir}/usr/lib/systemd/system-preset/10-mimos.preset"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
