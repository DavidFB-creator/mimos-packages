# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-release
pkgver=0.5.0.beta.3
pkgrel=1
pkgdesc='Release identity for MimOS'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
source=('mimos-release' 'mimos-mirrorlist' 'mimos-release.install' 'LICENSE')
sha256sums=('0d9a06c50947d60d64da7fdfd8c17eb4ac0e66ab81d1bf30f210cdbb313e1a29'
            '324741c65ad2bdafe4d9c45f15ea24e57c6e48ae31bd3f89e08c7e5df482f8ae'
            'e9fe9cb577d4f2a07660db3f1e25f3dac81d4d0aae856c201d39f92889f60db5'
            '97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf')
# The mirrorlist is configuration: a user who edits it must not have it
# overwritten by the next update, and pacman must leave a .pacnew instead.
backup=('etc/pacman.d/mimos-mirrorlist')
# The channel section is appended to /etc/pacman.conf by the scriptlet rather
# than shipped as a file, because that file belongs to pacman and no pristine
# copy exists to base ours on. See the install file for the full reasoning.
install='mimos-release.install'

package() {
  install -Dm644 mimos-release "${pkgdir}/etc/mimos-release"
  # Every mirror is commented out, and no [mimos] section exists in the image
  # to read them. Shipping the list before the repository answers would fail
  # the Live matrix's `pacman -Syu`. See packages/mimos-keyring/KEY.md.
  install -Dm644 mimos-mirrorlist \
    "${pkgdir}/etc/pacman.d/mimos-mirrorlist"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
