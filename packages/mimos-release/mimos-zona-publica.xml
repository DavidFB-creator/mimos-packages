<?xml version="1.0" encoding="utf-8"?>
<!-- MimOS override of firewalld's public zone (ADR-151, David's ease
     amendment). Identical to the stock /usr/lib/firewalld/zones/public.xml
     of the composed image, measured on the exact 0.9.0-beta.1 bytes rather
     than remembered, plus exactly one addition: the kdeconnect service
     (ports 1714-1764 TCP+UDP), so a phone can pair with the desktop. The
     service NAME is "kdeconnect" - the definition firewalld actually ships;
     "kde-connect" is a plausible wrong guess that would open nothing and
     fail silently. ssh stays because the stock zone carries it and MimOS
     diagnostic sessions use it; no sshd runs by default, so it is a rule
     without a listener. -->
<zone>
  <short>Public</short>
  <description>For use in public areas. You do not trust the other computers on networks to not harm your computer. Only selected incoming connections are accepted.</description>
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
  <service name="kdeconnect"/>
  <forward/>
</zone>
