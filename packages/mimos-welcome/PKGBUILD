# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-welcome
pkgver=1.0.1
pkgrel=1
pkgdesc='Centro de MimOS welcome and privacy application, and the Tienda'
# Compiled since the runner exists: the generic qml6 tool declares its own
# window identity (org.qt-project.qml, the Qr icon) and KWin honours the
# window over any desktop file, so the identity must be owned in C++.
arch=('x86_64')
# No debug split: the host makepkg.conf would otherwise emit a -debug
# package and the ephemeral repository's package count is exact.
options=('!debug')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
# gettext: the launchers and mimos-diagnostico read their strings through
# /usr/bin/gettext and gettext.sh (ADR-159). It is in base, so this is a
# declaration of what is already true rather than a new download.
depends=('bash' 'gettext' 'qt6-declarative' 'mimos-branding')
# qt6-tools for lrelease and gettext for msgfmt: the Catalan catalogues are
# compiled here rather than committed as .qm/.mo, because a compiled
# catalogue is a build artefact of the source beside it and committing both
# is how the two drift apart.
makedepends=('gcc' 'pkgconf' 'qt6-tools' 'gettext')
optdepends=(
  'kdialog: show graphical error messages'
  'mimos-release: version-aware autostart'
  'mimos-welcome-live: the Live-session Centro this launcher delegates to'
  'plasma-workspace: apply the MimOS Global Themes'
  'paru: the Tienda advanced path into the whole catalogue and the AUR'
)
source=(
  'mimos-welcome'
  'mimos-diagnostico'
  'Main.qml'
  'Window.qml'
  'mimos-welcome.desktop'
  'mimos-welcome-autostart.desktop'
  'centro-main.cpp'
  'mimos-tienda'
  'mimos-tienda-instalar'
  'TiendaMain.qml'
  'TiendaWindow.qml'
  'tienda-main.cpp'
  'mimos-tienda.desktop'
  'mimos-aplicaciones.json'
  'mimos-aplicaciones.lista'
  'centro_ca.ts'
  'tienda_ca.ts'
  'mimos-welcome.ca.po'
  'LICENSE'
)
