# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-welcome
pkgver=0.4.0.beta.1
pkgrel=1
pkgdesc='Centro de MimOS welcome and privacy application'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
depends=('bash' 'qt6-declarative')
optdepends=(
  'kdialog: show graphical error messages'
  'mimos-installer: launch MimOS Installer'
  'mimos-release: version-aware autostart'
  'plasma-workspace: apply the MimOS wallpaper'
)
source=(
  'mimos-welcome'
  'mimos-diagnostico'
  'Main.qml'
  'Window.qml'
  'mimos-welcome.desktop'
  'mimos-welcome-autostart.desktop'
  'LICENSE'
)
sha256sums=('cac6b2573214d9de53b6ec72ca35e62c2e1e9c778122c99e33f8c2727b89d858'
            '7770a8046c166b04fbfd7d6fe4b1abd58ae71d0459456e18906a7b1ba3faf952'
            '23e9e40b4fe232e5a5dc200b75bd6c7a5bb7d5b06f8513390d207c052f038c3e'
            '4e3b3aa9f1587f76cdd736ab2b7b611628221e4a69ceecee4044c6b13d7dbf35'
            '78f118314a87d92961826cd87c84cfd12b029b99ed36e9404f4ab892aa172398'
            '78c2283d05869013f84bca6e89433ec9312bd30978293cbb49650afcaa59770c'
            '97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf')

package() {
  install -Dm755 mimos-welcome "${pkgdir}/usr/bin/mimos-welcome"
  # The manual diagnostic bundle: collect, redact, show everything, and only
  # then write a local archive. Deliberately a plain CLI with no network
  # capability; Centro de MimOS's support switches still only store defaults
  # and are not wired to it. See ADR-086.
  install -Dm755 mimos-diagnostico "${pkgdir}/usr/bin/mimos-diagnostico"
  install -Dm644 Main.qml "${pkgdir}/usr/share/mimos/welcome/Main.qml"
  install -Dm644 Window.qml "${pkgdir}/usr/share/mimos/welcome/Window.qml"
  install -Dm644 mimos-welcome.desktop \
    "${pkgdir}/usr/share/applications/mimos-welcome.desktop"
  install -Dm644 mimos-welcome-autostart.desktop \
    "${pkgdir}/etc/xdg/autostart/mimos-welcome.desktop"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
