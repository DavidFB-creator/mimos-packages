build() {
  # Both runners install the session's catalogue from the same directory
  # before the QML loads (ADR-159); the directory is a compile-time literal
  # like the window path, so a test can point a real runner at a sandbox.
  g++ -std=c++17 -fPIC ${CXXFLAGS} centro-main.cpp \
    -DCENTRO_WINDOW_QML='"/usr/share/mimos/welcome/Window.qml"' \
    -DTRADUCCIONES_DIR='"/usr/share/mimos/translations"' \
    $(pkg-config --cflags --libs Qt6Qml Qt6Gui Qt6Core) \
    ${LDFLAGS} -o centro-mimos
  # The Tienda gets its own runner for the same identity reason (ADR-152).
  g++ -std=c++17 -fPIC ${CXXFLAGS} tienda-main.cpp \
    -DTIENDA_WINDOW_QML='"/usr/share/mimos/tienda/TiendaWindow.qml"' \
    -DTRADUCCIONES_DIR='"/usr/share/mimos/translations"' \
    $(pkg-config --cflags --libs Qt6Qml Qt6Gui Qt6Core) \
    ${LDFLAGS} -o tienda-mimos
  # The Catalan catalogues (ADR-159): Qt's for the two QML applications,
  # gettext's for the launchers and mimos-diagnostico.
  /usr/lib/qt6/bin/lrelease -silent centro_ca.ts -qm centro_ca.qm
  /usr/lib/qt6/bin/lrelease -silent tienda_ca.ts -qm tienda_ca.qm
  msgfmt --check --output-file mimos-welcome.mo mimos-welcome.ca.po
}

package() {
  install -Dm755 mimos-welcome "${pkgdir}/usr/bin/mimos-welcome"
  install -Dm755 centro-mimos "${pkgdir}/usr/lib/mimos/centro-mimos"
  # The manual diagnostic bundle: collect, redact, show everything, and only
  # then write a local archive. Deliberately a plain CLI with no network
  # capability; Centro de MimOS's support switches still only store defaults
  # and are not wired to it. See ADR-086.
  install -Dm755 mimos-diagnostico "${pkgdir}/usr/bin/mimos-diagnostico"
  install -Dm644 Main.qml "${pkgdir}/usr/share/mimos/welcome/Main.qml"
  install -Dm644 Window.qml "${pkgdir}/usr/share/mimos/welcome/Window.qml"
  install -Dm644 mimos-welcome.desktop \
    "${pkgdir}/usr/share/applications/mimos-welcome.desktop"
  install -Dm644 mimos-welcome-autostart.desktop \
    "${pkgdir}/etc/xdg/autostart/mimos-welcome.desktop"
  # Tienda de MimOS (ADR-152): curated installer with the Centro's exact
  # architecture. The .lista is the launcher's allowlist -- derived from
  # the canonical JSON by scripts/generate-tienda-catalogo.py, verified by
  # make check, and shipped read-only where the launcher expects it.
  install -Dm755 mimos-tienda "${pkgdir}/usr/bin/mimos-tienda"
  install -Dm755 tienda-mimos "${pkgdir}/usr/lib/mimos/tienda-mimos"
  install -Dm755 mimos-tienda-instalar \
    "${pkgdir}/usr/lib/mimos/mimos-tienda-instalar"
  install -Dm644 TiendaMain.qml \
    "${pkgdir}/usr/share/mimos/tienda/TiendaMain.qml"
  install -Dm644 TiendaWindow.qml \
    "${pkgdir}/usr/share/mimos/tienda/TiendaWindow.qml"
  install -Dm644 mimos-aplicaciones.json \
    "${pkgdir}/usr/share/mimos/tienda/aplicaciones.json"
  install -Dm644 mimos-aplicaciones.lista \
    "${pkgdir}/usr/share/mimos/tienda/aplicaciones.lista"
  install -Dm644 mimos-tienda.desktop \
    "${pkgdir}/usr/share/applications/mimos-tienda.desktop"
  # Where the runners look for the session's language (ADR-159). The .qm
  # names are what QTranslator::load derives from the locale: centro_ca for
  # ca_ES, ca_AD and plain ca alike.
  install -Dm644 centro_ca.qm "${pkgdir}/usr/share/mimos/translations/centro_ca.qm"
  install -Dm644 tienda_ca.qm "${pkgdir}/usr/share/mimos/translations/tienda_ca.qm"
  install -Dm644 mimos-welcome.mo \
    "${pkgdir}/usr/share/locale/ca/LC_MESSAGES/mimos-welcome.mo"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
