	optdepends = kdialog: show graphical error messages
	optdepends = mimos-release: version-aware autostart
	optdepends = mimos-welcome-live: the Live-session Centro this launcher delegates to
	optdepends = plasma-workspace: apply the MimOS Global Themes
	optdepends = paru: the Tienda advanced path into the whole catalogue and the AUR
	options = !debug
