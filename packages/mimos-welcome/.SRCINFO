pkgbase = mimos-welcome
	pkgdesc = Centro de MimOS welcome and privacy application, and the Tienda
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/DavidFB-creator/MimOS
	arch = x86_64
	license = MIT
	makedepends = gcc
	makedepends = pkgconf
	depends = bash
	depends = qt6-declarative
