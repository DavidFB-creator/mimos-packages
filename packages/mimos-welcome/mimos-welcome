#!/usr/bin/env bash
set -Eeuo pipefail

window='/usr/share/mimos/welcome/Window.qml'
release_file='/etc/mimos-release'
live_marker='/usr/lib/mimos/live-environment'
live_launcher='/usr/bin/mimos-welcome-live'
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/mimos"
config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/mimos"
config_file="${config_dir}/centro.conf"
autostart=false
runtime_context='installed'

show_error() {
  local message="$1"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title 'Centro de MimOS' --error "${message}" || true
  else
    printf '%s\n' "${message}" >&2
  fi
}

case "${1:-}" in
  '')
    ;;
  --autostart)
    autostart=true
    ;;
  *)
    printf 'Usage: %s [--autostart]\n' "$0" >&2
    exit 2
    ;;
esac

if [[ -f "${live_marker}" && ! -L "${live_marker}" ]] && \
  [[ "$(stat -c '%u:%g:%a' "${live_marker}")" == '0:0:644' ]]; then
  runtime_context='live'
fi

# In a Live session the Live-only application owns the welcome experience
# (ADR-093). The menu entry delegates so one "Centro de MimOS" does the right
# thing in both worlds; on autostart the Live package's own entry is the one
# that runs, so this exits rather than opening a second window. The installed
# interface never renders in a Live session: fail closed if the Live
# application is missing rather than falling through.
if [[ "${runtime_context}" == 'live' ]]; then
  if [[ "${autostart}" == true ]]; then
    exit 0
  fi
  if [[ -x "${live_launcher}" ]]; then
    exec "${live_launcher}"
  fi
  show_error 'La sesión Live no tiene disponible su Centro de MimOS.'
  exit 1
fi

if [[ ! -f "${window}" ]]; then
  show_error 'No se encuentra la interfaz de Centro de MimOS.'
  exit 1
fi

version_id='development'
if [[ -f "${release_file}" ]]; then
  detected_version="$(sed -n 's/^VERSION_ID="\(.*\)"/\1/p' "${release_file}")"
  [[ -n "${detected_version}" ]] && version_id="${detected_version}"
fi
marker="${state_dir}/welcome-${version_id}"

mkdir -p -- "${state_dir}" "${config_dir}"

if [[ "${autostart}" == true ]]; then
  if [[ -e "${marker}" ]]; then
    exit 0
  fi
  if [[ -f "${config_file}" ]] && \
    grep -Eq '^showAfterUpdates=(false|0)$' "${config_file}"; then
    touch -- "${marker}"
    exit 0
  fi
fi

# The window follows the desktop theme without gaining any file capability:
# the launcher reads the session's ColorScheme and passes the side as an
# argument (ADR-093). Reading only; the QML never touches the file.
detect_appearance() {
  local kdeglobals="${XDG_CONFIG_HOME:-${HOME}/.config}/kdeglobals"
  local scheme=''
  if [[ -f "${kdeglobals}" ]]; then
    scheme="$(sed -n 's/^ColorScheme=//p' "${kdeglobals}" | head -n 1)"
  fi
  case "${scheme}" in
    *[Oo]scur*|*[Nn]octurn*|*[Dd]ark*|*[Bb]reeze[Dd]ark*)
      printf 'oscuro'
      ;;
    *)
      printf 'claro'
      ;;
  esac
}

# The compiled runner owns the window's identity: the generic qml6 tool
# declares desktopFileName org.qt-project.qml and its own Qr icon over the
# Wayland toplevel-icon protocol, which no desktop file or KWin rule could
# override (ADR-093).
runner='/usr/lib/mimos/centro-mimos'
if [[ ! -x "${runner}" ]]; then
  show_error 'El entorno de Centro de MimOS no está disponible.'
  exit 1
fi

export QT_QUICK_CONTROLS_STYLE='Basic'

# Statuses 11 and 12 apply a Global Theme and relaunch, so the window reopens
# already repainted on the new side; 13 hands over to Discover. The exits are
# the whole action channel: the QML has no process capability, mirroring the
# Live installer's status-10 pattern (ADR-093).
final_status=0
while true; do
  appearance="$(detect_appearance)"
  set +e
  "${runner}" '--mimos-context=installed' "--mimos-appearance=${appearance}"
  status=$?
  set -e

  case "${status}" in
    0)
      break
      ;;
    10)
      show_error 'El instalador solo está disponible desde el entorno Live.'
      final_status=1
      break
      ;;
    11)
      if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
        plasma-apply-lookandfeel -a org.mimos.claro.desktop \
          >/dev/null 2>&1 || show_error 'No se pudo aplicar MimOS Claro.'
      else
        show_error 'La herramienta de temas de Plasma no está disponible.'
      fi
      continue
      ;;
    12)
      if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
        plasma-apply-lookandfeel -a org.mimos.oscuro.desktop \
          >/dev/null 2>&1 || show_error 'No se pudo aplicar MimOS Oscuro.'
      else
        show_error 'La herramienta de temas de Plasma no está disponible.'
      fi
      continue
      ;;
    13)
      if command -v plasma-discover >/dev/null 2>&1; then
        plasma-discover >/dev/null 2>&1 &
      else
        show_error 'Discover no está disponible en este sistema.'
        final_status=1
      fi
      break
      ;;
    *)
      printf 'Centro de MimOS exited with status %s.\n' "${status}" >&2
      final_status="${status}"
      break
      ;;
  esac
done

if [[ "${autostart}" == true ]]; then
  touch -- "${marker}"
fi

exit "${final_status}"
