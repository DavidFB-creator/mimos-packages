#!/usr/bin/env bash
# Tell the running session about the launcher shortcut, because placing the
# file is not enough — and registering it is not enough either.
#
# MimOS ships Meta+Return for the terminal in /etc/skel/.config/
# kglobalshortcutsrc. kglobalaccel reads it and reports the binding
# correctly — and nobody grabs the key, so the press goes to whatever window
# has focus. ADR-134 measured that on a physical 0.7 and repaired it with
# doRegister + setShortcutKeys, read off dbus-monitor while the Settings app
# reassigned the shortcut by hand.
#
# That repair was refuted on the first physical 0.8.0-beta.2 install
# (ADR-145). The marker said `aplicado`, the read-back saw the key, and the
# press did nothing — in the first session AND after a relogin, because
# kglobalaccel's model and the compositor's grab are different facts, and
# doRegister + setShortcutKeys only updates the model when the caller is not
# the component itself. A longer dbus-monitor capture of the one path known
# to work showed the Settings app makes exactly ONE call for a service
# action, and it is the one ADR-134 dismissed:
#
#     setForeignShortcutKeys(actionId, [([key, 0, 0, 0],)])
#
# "Foreign" is the point: a service action has no live process to claim its
# own shortcut, so the grab is installed on behalf of someone else. The 0.7
# attempt at this method failed because it was called with a third flags
# argument the signature does not have — KGlobalAccelD runs inside the
# compositor and libdbus turns a demarshalling error into an abort, which is
# also why the argument shape below is pinned by tests.
#
# Measured in both directions against the exact 0.8.0-beta.2 bytes in QEMU,
# with a REAL key press through the monitor: the pristine session launches
# nothing (the defect reproduced under automation for the first time), and
# after this single call the same press launches the terminal.
#
# The four integers are what a QKeySequence carries — Qt keeps four slots and
# the demarshaller reads all four; giving it one is what killed the
# compositor in 0.7.
set -Eeuo pipefail

# The marker carries a GENERATION in its name (ADR-147). Machines installed
# before ADR-146 hold `atajos-preparados` written by helpers whose repair
# was refuted (ADR-134's model-only calls) or whose transient failures were
# recorded as permanent — and the helper runs once per account, so no
# package upgrade could reach them. Renaming the marker is the migration:
# on the first login after upgrading, the legacy marker is removed once and
# the ADR-146 helper runs again. That re-run is SAFE only because of the
# `respetado` guard below — a binding the user changed or removed is
# recognised and never overwritten, and re-asserting Meta+Return over the
# skel default is the exact call the Settings app makes.
marcador="${mimos_test_marcador:-${XDG_STATE_HOME:-${HOME}/.local/state}/mimos/atajos-preparados-2}"
legado="$(dirname -- "${marcador}")/atajos-preparados"
[[ -e "${marcador}" ]] && exit 0
[[ -e "${legado}" ]] && rm -f -- "${legado}"

# Meta+Return as Qt encodes it, with the arithmetic written down rather than
# left as a magic number:
#
#   Meta    0x10000000   268435456
#   Return  0x01000004    16777220
#                        ---------
#                        285212676
readonly META_RETURN=285212676
readonly ACCION="['com.mitchellh.ghostty.desktop','_launch','Ghostty','Ghostty']"
readonly COMPONENTE=/component/com_mitchellh_ghostty_desktop

anotar() {
  local directorio
  directorio="$(dirname -- "${marcador}")"
  # Created only when missing. `install -d` on a directory that already
  # exists also resets its mode, which is somebody else's decision when the
  # directory is one this helper did not make. Same rule as the battery and
  # touchpad helpers.
  [[ -d "${directorio}" ]] || install -d -m 0700 -- "${directorio}"
  printf '%s\n' "$1" > "${marcador}"
  exit 0
}

command -v gdbus > /dev/null 2>&1 || anotar 'sin-gdbus'
command -v qdbus6 > /dev/null 2>&1 || anotar 'sin-qdbus'

llamar() {
  gdbus call --session --dest org.kde.kglobalaccel \
    --object-path /kglobalaccel --method "org.kde.KGlobalAccel.$1" "${@:2}"
}

leer_modelo() {
  qdbus6 --literal org.kde.kglobalaccel "${COMPONENTE}" \
    org.kde.kglobalaccel.Component.allShortcutInfos 2>/dev/null || true
}

# The service is D-Bus activated and the session may still be assembling when
# autostart fires. Bounded — and a session that never answers writes NO
# marker, so the next login retries. The marker used to be written here, which
# is ADR-123's second defect in another file: one slow first login — exactly
# the login this helper exists for — recorded `sin-sesion` and the machine
# never fixed itself. The touchpad helper already refuses to claim done on a
# transient failure; same rule here. A session where the bus truly never
# comes up retries a bounded 30-second probe per login, which is the cheap
# side of that trade.
listo=0
for _ in $(seq 1 30); do
  if llamar allComponents > /dev/null 2>&1; then
    listo=1
    break
  fi
  sleep 1
done
if (( listo == 0 )); then
  printf 'The session bus never answered; will retry next login.\n' >&2
  exit 0
fi

# Never override a choice the person already made — the rule the battery and
# touchpad helpers state, and this one lacked. The model is asked BEFORE
# assigning: on a pristine account it reports Meta+Return, because the skel
# file registers the binding (measured on the beta.2 bytes — registered,
# read back green, and still dead, which is the whole of ADR-145). Only that
# case needs the grab installed. Anything else — the user reassigned it, the
# user removed it, the component is not there because Ghostty is gone — is a
# state this helper must not touch.
if [[ "$(leer_modelo)" != *"${META_RETURN}"* ]]; then
  anotar 'respetado'
fi

# The one call the Settings app makes, exactly as captured: two arguments,
# no flags. Adding a flags argument is the mistake that aborted KWin in 0.7.
llamar setForeignShortcutKeys "${ACCION}" "[([${META_RETURN}, 0, 0, 0],)]" \
  > /dev/null 2>&1 || anotar 'asignacion-rechazada'

# Read it back from the session rather than trusting the call's exit status —
# knowing its limit: this asks kglobalaccel's model, which cannot see the
# compositor's grab (ADR-145 is the proof: it answered yes on a machine where
# the key did nothing). It still catches a call the session rejected
# outright. The gate that can fail on a missing grab lives in the e2e: a real
# Meta+Return through the QEMU monitor, followed by pgrep.
if [[ "$(leer_modelo)" != *"${META_RETURN}"* ]]; then
  anotar 'no-confirmado'
fi

anotar 'aplicado'
