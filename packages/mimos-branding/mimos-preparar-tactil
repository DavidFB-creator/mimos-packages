#!/usr/bin/env bash
# Gives a new account the touchpad behaviour MimOS considers sane on a laptop:
# natural scrolling on, and no disabling while typing.
#
# **This cannot be a file in /etc/skel, which is why it exists.** KDE stores
# libinput settings under a section keyed by the device itself --
# `[Libinput][<vendor>][<product>][<device name>]` -- so a shipped kcminputrc
# would only ever apply to the one laptop it was copied from, and silently do
# nothing everywhere else. The section has to be written on the machine, after
# the machine can be asked what its touchpad is.
#
# Three details were measured on real hardware rather than assumed, and each
# one would have produced a file that looks right and changes nothing:
#
#   * the vendor and product in the key are DECIMAL, while /sys reports them
#     in hex. 093a/200a becomes 2362/8202.
#   * the device name in the key is the kernel's `name` attribute verbatim,
#     spaces and colons included: "ASUP1200:00 093A:200A Touchpad".
#   * the same physical hardware also exposes a *Mouse* device, with its own
#     section and deliberately different settings. Matching on the vendor, or
#     on anything looser than "this is a touchpad", would change a pointing
#     device the user never asked about.
#
# It runs once per account and never overrides a value the user already set:
# a person who turns natural scrolling off must find it off tomorrow. See
# ADR-105.
set -Eeuo pipefail

config="${mimos_test_kcminputrc:-${XDG_CONFIG_HOME:-${HOME}/.config}/kcminputrc}"
marker="${mimos_test_marker:-${XDG_STATE_HOME:-${HOME}/.local/state}/mimos/tactil-preparado}"
devices="${mimos_test_sys_input:-/sys/class/input}"

[[ -e "${marker}" ]] && exit 0

# A test override wins over the real tool, and that ordering is the fix for a
# false pass. The other way round, this helper picked up whichever
# kwriteconfig6 happened to be installed, so the behavioural test measured the
# real tool on a developer machine and its own stub in CI -- two different
# programs, one of them never exercised where it mattered. The test passed
# locally and failed on the runner, which is the good outcome of a bad
# instrument.
writer="${mimos_test_writer:-}"
if [[ -z "${writer}" ]] && command -v kwriteconfig6 > /dev/null 2>&1; then
  writer='kwriteconfig6'
fi
if [[ -z "${writer}" ]]; then
  printf 'kwriteconfig6 is not available; leaving the touchpad alone.\n' >&2
  exit 0
fi

# Hex in /sys, decimal in the key. Leading zeros must go or the shell reads
# the value as octal -- 0093 would be a syntax error, and a silent one in the
# wrong hands.
a_decimal() {
  printf '%d' "$((16#${1#0x}))"
}

# Push the two settings into the running KWin, for the device with this
# exact name. Returns 0 only if KWin confirmed the value it now holds, so the
# caller can tell "applied" from "attempted" -- which is what the marker below
# depends on.
#
# The tool is looked up rather than assumed: dbus-send is in the base system
# and qdbus is not, and a helper that silently does nothing because a binary
# is missing is the failure mode this whole file exists to avoid.
aplicar_en_sesion() {
  local objetivo="$1" ruta nombre_kwin
  local emisor="${mimos_test_dbus:-}"
  if [[ -z "${emisor}" ]]; then
    command -v dbus-send > /dev/null 2>&1 || return 1
    emisor='dbus-send'
  fi

  local leer=(--session --print-reply --dest=org.kde.KWin)
  for ruta in $("${emisor}" "${leer[@]}" /org/kde/KWin/InputDevice \
    org.freedesktop.DBus.Properties.Get string:org.kde.KWin.InputDeviceManager \
    string:devicesSysNames 2>/dev/null | grep -o 'event[0-9]*'); do
    nombre_kwin="$("${emisor}" "${leer[@]}" "/org/kde/KWin/InputDevice/${ruta}" \
      org.freedesktop.DBus.Properties.Get string:org.kde.KWin.InputDevice \
      string:name 2>/dev/null | sed -n 's/.*string "\(.*\)"$/\1/p' | tail -1)"
    [[ "${nombre_kwin}" == "${objetivo}" ]] || continue

    # `--print-reply` is what makes these synchronous, and it is load-bearing.
    # Without it dbus-send returns the moment the message is queued, the
    # read-back below runs before KWin has processed anything, and the answer
    # is whatever the value was already. Measured on David's laptop: with the
    # property already true the check passed and proved nothing; forced to
    # false first, the same code failed. A verification that cannot fail is
    # not a verification.
    "${emisor}" --session --print-reply --dest=org.kde.KWin \
      "/org/kde/KWin/InputDevice/${ruta}" \
      org.freedesktop.DBus.Properties.Set string:org.kde.KWin.InputDevice \
      string:naturalScroll variant:boolean:true > /dev/null 2>&1
    "${emisor}" --session --print-reply --dest=org.kde.KWin \
      "/org/kde/KWin/InputDevice/${ruta}" \
      org.freedesktop.DBus.Properties.Set string:org.kde.KWin.InputDevice \
      string:disableWhileTyping variant:boolean:false > /dev/null 2>&1

    # Read it back. A Set that KWin ignored returns success just the same,
    # and this project has been caught by exactly that shape before.
    "${emisor}" "${leer[@]}" "/org/kde/KWin/InputDevice/${ruta}" \
      org.freedesktop.DBus.Properties.Get string:org.kde.KWin.InputDevice \
      string:naturalScroll 2>/dev/null | grep -q 'boolean true' && return 0
    return 1
  done
  return 1
}

encontrado=0
aplicado=0
for device in "${devices}"/event*/device; do
  [[ -r "${device}/name" ]] || continue

  # The authoritative question is "does the kernel classify this as a
  # touchpad", not "is Touchpad in its name". INPUT_PROP_POINTER (bit 0) plus
  # INPUT_PROP_BUTTONPAD is how libinput decides; the properties file is the
  # same source. A name match alone would catch a keyboard called "Touchpad
  # Keys" and miss a touchpad that is not called one.
  propiedades="$(cat "${device}/properties" 2>/dev/null || printf '0')"
  nombre="$(cat "${device}/name" 2>/dev/null || true)"
  [[ -n "${nombre}" ]] || continue
  if (( (0x${propiedades#0x} & 0x4) == 0 )); then
    # Not a buttonpad. Fall back to the name, because some touchpads do not
    # set the property and a laptop with no touchpad settings at all is a
    # worse outcome than a slightly loose match.
    case "${nombre}" in
      *Touchpad*|*touchpad*|*TouchPad*|*Trackpad*) ;;
      *) continue ;;
    esac
  fi

  vendor="$(cat "${device}/id/vendor" 2>/dev/null || true)"
  product="$(cat "${device}/id/product" 2>/dev/null || true)"
  [[ -n "${vendor}" && -n "${product}" ]] || continue

  vendor_decimal="$(a_decimal "${vendor}")"
  product_decimal="$(a_decimal "${product}")"
  # An array, and every expansion quoted. Device names contain spaces --
  # "ASUP1200:00 093A:200A Touchpad" is a perfectly ordinary one -- so an
  # unquoted expansion here splits the name into three arguments and
  # kwriteconfig6 cheerfully writes `NaturalScroll=093A:200A` into a group
  # named after the first word. Watched happen on real hardware; nothing
  # about the result looks wrong until you read it.
  argumentos=(
    --file "${config}"
    --group Libinput
    --group "${vendor_decimal}"
    --group "${product_decimal}"
    --group "${nombre}"
  )

  # Never overwrite a decision the person already made. `kreadconfig6` would
  # be the natural partner here, but reading the file directly keeps this
  # testable without a KDE installation and answers the same question.
  ya_tiene() {
    local clave="$1"
    grep -Fq "${clave}=" <<< "$(
      awk -v v="[Libinput][${vendor_decimal}][${product_decimal}][${nombre}]" '
        $0 == v { dentro = 1; next }
        /^\[/ { dentro = 0 }
        dentro { print }
      ' "${config}" 2>/dev/null
    )"
  }

  ya_tiene NaturalScroll ||
    "${writer}" "${argumentos[@]}" --key NaturalScroll true
  ya_tiene DisableWhileTyping ||
    "${writer}" "${argumentos[@]}" --key DisableWhileTyping false

  # Writing the file is not applying it, and on a fresh installation that
  # distinction is the whole defect. KWin reads kcminputrc when the session
  # starts; this helper runs from autostart, which is after. So the file is
  # correct and the touchpad behaves the old way until the person logs in a
  # second time -- and the only login that matters, the first one after
  # installing, is the one that always gets it wrong. Measured on David's
  # laptop on 2026-08-10: with the file already written, KWin reported
  # naturalScroll=false; after restarting the session it reported true and
  # the touchpad behaved.
  #
  # So tell the running session as well. KWin exposes each device on D-Bus
  # with writable properties, matched here by the device name we just
  # configured -- the same string, so a machine with two devices from the
  # same hardware cannot get them confused.
  aplicar_en_sesion "${nombre}" && aplicado=1

  printf 'Touchpad prepared: %s\n' "${nombre}"
  encontrado=1
done

if (( encontrado == 0 )); then
  printf 'No touchpad on this machine; nothing to prepare.\n'
fi

# The marker means "this account is done", and it must only be written when
# that is true. It used to be written unconditionally, which turned any
# one-off failure into a permanent one: a login where the touchpad had not
# been enumerated yet, or where the session bus was not up, left a marker
# behind and the helper never ran again. The person is then stuck with a
# machine that will not fix itself, and nothing anywhere says why.
#
# A machine with no touchpad is genuinely done -- a desktop must not rescan
# its input devices at every login for the rest of its life. A machine with a
# touchpad is done only once the setting reached the running session.
#
# And it says WHICH of those two it was. An empty file cannot tell "the
# setting reached KWin" from "there was no touchpad here", so the e2e's only
# possible assertion was `test -e`, and the VM has no touchpad -- meaning
# ADR-123's whole fix, telling the live session over D-Bus, had no runtime
# gate at all. The battery helper already got this right: its marker holds
# `sin-bateria` and the e2e demands that exact word. Same shape here.
anotar() {
  local directorio
  directorio="$(dirname -- "${marker}")"
  [[ -d "${directorio}" ]] || install -d -m 0700 -- "${directorio}"
  printf '%s\n' "$1" > "${marker}"
}

if (( encontrado == 0 )); then
  anotar 'sin-tactil'
elif (( aplicado == 1 )); then
  anotar 'aplicado'
else
  printf 'The touchpad was configured but the session did not confirm it; will retry next login.\n' >&2
fi
