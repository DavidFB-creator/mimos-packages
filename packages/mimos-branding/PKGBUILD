pkgname=mimos-branding
pkgver=0.5.0.beta.3
pkgrel=1
pkgdesc='Runtime visual identity assets for MimOS'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
source=(
  'mimi.svg'
  'mimos-logo-horizontal.svg'
  'mimos-logo-monochrome-dark.svg'
  'mimos-logo-monochrome-light.svg'
  'mimos-logo-stacked.svg'
  'mimos-symbol.svg'
  'mimos-wordmark.svg'
  'mimos-logo-horizontal-dark.svg'
  'mimos-logo-horizontal-dark-no-tagline.svg'
  'mimos-logo-stacked-dark.svg'
  'mimos-wordmark-dark.svg'
  'mimos-logo-horizontal-2400.png'
  'mimos-logo-stacked-1800.png'
  'mimos-symbol-1024.png'
  'mimos-wordmark-2000.png'
  'primer-abrazo.svg'
  'primer-abrazo.png'
  'arrumaco-claro.svg'
  'arrumaco-claro.png'
  'arrumaco-oscuro.svg'
  'arrumaco-oscuro.png'
  'wallpaper-arrumaco-claro-metadata.json'
  'wallpaper-arrumaco-oscuro-metadata.json'
  'login-abrazo.svg'
  'login-abrazo.png'
  'fastfetch-config.jsonc'
  'mimos-fastfetch-heart.txt'
  'palette.json'
  'mimos-claro.colors'
  'mimos-oscuro.colors'
  'mimos-nocturnos.colors'
  'kdeglobals'
  'speechd.conf'
  'sddm-theme.conf.user'
  '20-mimos-theme.conf'
  'system-hibernate.svg'
  'system-reboot.svg'
  'system-shutdown.svg'
  'system-suspend.svg'
  'system-user-list.svg'
  'system-user-prompt.svg'
  'go-next.svg'
  'go-previous.svg'
  'index.theme'
  'app-mimos-centro.svg'
  'app-mimos-centro-small.svg'
  'app-mimos-instalador.svg'
  'start-here.svg'
  'mimos-escritorio-index.theme'
  'sddm-kdeglobals'
  'mimos-tmpfiles.conf'
  'mimi-face.png'
  'mimos-install-default-face'
  'LICENSE'
)
