pkgver=0.4.0.beta.1
pkgrel=1
pkgdesc='Runtime visual identity assets for MimOS'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
source=(
  'mimi.svg'
  'mimos-logo-horizontal.svg'
  'mimos-logo-monochrome-dark.svg'
