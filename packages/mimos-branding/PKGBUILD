package() {
  local asset
  for asset in \
    mimi.svg \
    mimos-logo-horizontal.svg \
    mimos-logo-monochrome-dark.svg \
    mimos-logo-monochrome-light.svg \
    mimos-logo-stacked.svg \
    mimos-symbol.svg \
    mimos-wordmark.svg \
    mimos-logo-horizontal-dark.svg \
    mimos-logo-horizontal-dark-no-tagline.svg \
    mimos-logo-stacked-dark.svg \
    mimos-wordmark-dark.svg \
    mimos-logo-horizontal-2400.png \
    mimos-logo-stacked-1800.png \
    mimos-symbol-1024.png \
    mimos-wordmark-2000.png; do
    install -Dm644 "${asset}" \
      "${pkgdir}/usr/share/mimos/branding/${asset}"
  done

  install -Dm644 primer-abrazo.svg \
    "${pkgdir}/usr/share/backgrounds/mimos/primer-abrazo.svg"
  install -Dm644 primer-abrazo.png \
    "${pkgdir}/usr/share/backgrounds/mimos/primer-abrazo.png"
  # The login background is a separate image from the desktop wallpaper, and
  # deliberately so: Breeze draws the clock, the user name and the power
  # labels straight onto it in near-white, so its middle has to stay dark and
  # quiet. Reusing the desktop wallpaper is why the old greeter read as busy.
  install -Dm644 login-abrazo.svg \
    "${pkgdir}/usr/share/backgrounds/mimos/login-abrazo.svg"
  install -Dm644 login-abrazo.png \
    "${pkgdir}/usr/share/backgrounds/mimos/login-abrazo.png"
  install -Dm644 fastfetch-config.jsonc \
    "${pkgdir}/etc/xdg/fastfetch/config.jsonc"
  install -Dm644 mimos-fastfetch-heart.txt \
    "${pkgdir}/usr/share/mimos/branding/mimos-fastfetch-heart.txt"

  # Colour schemes are selectable from System Settings; kdeglobals sets the
  # MimOS default for the Live user and for any user a real installation
  # creates, because Calamares populates a new home from /etc/skel.
  local scheme
  for scheme in mimos-claro mimos-oscuro mimos-nocturnos; do
    install -Dm644 "${scheme}.colors" \
      "${pkgdir}/usr/share/color-schemes/${scheme}.colors"
  done
  install -Dm644 kdeglobals "${pkgdir}/etc/skel/.config/kdeglobals"

  # The same reasoning applies to speech. The image is Spanish and ships Orca,
  # but nothing told the synthesiser, so it read Spanish text with an English
  # accent. This is a skel default rather than a system file so a user can
  # override it without editing anything root owns.
  install -Dm644 speechd.conf \
    "${pkgdir}/etc/skel/.config/speech-dispatcher/speechd.conf"
  install -Dm644 palette.json \
    "${pkgdir}/usr/share/mimos/branding/palette.json"

  # Branding survives installation, so the login screen stays MimOS on the
  # installed system. theme.conf.user is Breeze's documented override and is
  # not shipped by plasma-workspace, so this conflicts with no package.
  install -Dm644 sddm-theme.conf.user \
    "${pkgdir}/usr/share/sddm/themes/breeze/theme.conf.user"
  install -Dm644 20-mimos-theme.conf \
    "${pkgdir}/etc/sddm.conf.d/20-mimos-theme.conf"

  # The greeter's power row asks the icon theme for six names (read out of
  # Breeze's Main.qml at v6.7.3, see ADR-084). The `mimos` theme overrides
  # exactly those six and inherits breeze-dark for everything else; only the
  # greeter selects it, through the sddm user's kdeglobals below, so the
  # desktop keeps Breeze. go-next and go-previous are the seventh and eighth:
  # the login button's arrow, fixed Abrazo on purpose, because the greeter
  # recolours themed icons to the same near-white the button is filled with,
  # and a recolourable arrow is invisible there whether it is drawn or not.
  local icon
  for icon in \
    system-hibernate \
    system-reboot \
    system-shutdown \
    system-suspend \
    system-user-list \
    system-user-prompt \
    go-next \
    go-previous; do
    install -Dm644 "${icon}.svg" \
      "${pkgdir}/usr/share/icons/mimos/scalable/actions/${icon}.svg"
  done
  install -Dm644 index.theme "${pkgdir}/usr/share/icons/mimos/index.theme"

  # Application icons and the launcher heart (ADR-087). The desktop selects
  # mimos-escritorio through the generated skel kdeglobals; it inherits
  # breeze, so only these names change. MIMI carries the Centro icon at 32 px
  # and above; below that the small directory serves the bare heart, because
  # a face at 16 px is a smudge (branding/mimi/README.md, measured). The two
  # app icons also land in hicolor so they survive a user changing themes.
  local esc="${pkgdir}/usr/share/icons/mimos-escritorio"
  install -Dm644 mimos-escritorio-index.theme "${esc}/index.theme"
  install -Dm644 app-mimos-centro.svg "${esc}/scalable/apps/mimos-centro.svg"
  install -Dm644 app-mimos-instalador.svg "${esc}/scalable/apps/mimos-instalador.svg"
  install -Dm644 app-mimos-centro-small.svg "${esc}/small/apps/mimos-centro.svg"
  install -Dm644 app-mimos-instalador.svg "${esc}/small/apps/mimos-instalador.svg"
  install -Dm644 app-mimos-centro.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mimos-centro.svg"
  install -Dm644 app-mimos-instalador.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mimos-instalador.svg"
  # Every start-here name Breeze itself ships, coloured and symbolic, so
  # whichever one Kickoff's default asks for resolves to the heart.
  local sh
  for sh in start-here start-here-kde start-here-kde-plasma; do
    install -Dm644 start-here.svg "${esc}/scalable/places/${sh}.svg"
    install -Dm644 start-here-symbolic.svg "${esc}/scalable/places/${sh}-symbolic.svg"
  done

  # Selecting the theme for the greeter alone: sddm-greeter runs with
  # HOME=/var/lib/sddm and reads that home's kdeglobals -- the file KDE's own
  # SDDM settings module writes. The packaged copy lives under /usr/share and
  # a tmpfiles rule copies it into place at boot only when nothing is there
  # yet, because a package cannot own paths inside another package's home
  # directory without fighting its ownership.
  install -Dm644 sddm-kdeglobals \
    "${pkgdir}/usr/share/mimos/branding/sddm-kdeglobals"
  install -Dm644 mimos-tmpfiles.conf \
    "${pkgdir}/usr/lib/tmpfiles.d/mimos-branding.conf"

  # MIMI as the login avatar. Generated by scripts/generate-face-icon.py from
  # branding/mimi/mimi.svg on canonical Noche; the helper names it for the
  # UID-1000 account under /usr/share/sddm/faces, which is the only avatar
  # path SDDM prefers over Breeze's grey placeholder. Calamares runs the
  # helper after `users`; see shellprocess@default-face in
  # mimos-calamares-config.
  install -Dm644 mimi-face.png \
    "${pkgdir}/usr/share/mimos/branding/mimi-face.png"
  install -Dm755 mimos-install-default-face \
    "${pkgdir}/usr/bin/mimos-install-default-face"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
