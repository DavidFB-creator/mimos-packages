pkgname=mimos-branding
pkgver=0.8.0.beta.2
pkgrel=1
pkgdesc='Runtime visual identity assets for MimOS'
arch=('any')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
source=(
  'mimi.svg'
  'mimos-logo-horizontal.svg'
  'mimos-logo-monochrome-dark.svg'
  'mimos-logo-monochrome-light.svg'
  'mimos-logo-stacked.svg'
  'mimos-symbol.svg'
  'mimos-wordmark.svg'
  'mimos-logo-horizontal-dark.svg'
  'mimos-logo-horizontal-dark-no-tagline.svg'
  'mimos-logo-stacked-dark.svg'
  'mimos-wordmark-dark.svg'
  'mimos-logo-horizontal-2400.png'
  'mimos-logo-stacked-1800.png'
  'mimos-symbol-1024.png'
  'mimos-wordmark-2000.png'
  'primer-abrazo.svg'
  'primer-abrazo.png'
  'arrumaco-claro.svg'
  'arrumaco-claro.png'
  'arrumaco-oscuro.svg'
  'arrumaco-oscuro.png'
  'wallpaper-arrumaco-claro-metadata.json'
  'wallpaper-arrumaco-oscuro-metadata.json'
  'login-abrazo.svg'
  'login-abrazo.png'
  'fastfetch-config.jsonc'
  'fastfetch-config-plain.jsonc'
  'mimos-fastfetch-heart.txt'
  'palette.json'
  'mimos-claro.colors'
  'mimos-oscuro.colors'
  'mimos-nocturnos.colors'
  'kdeglobals'
  'ksmserverrc'
  'ksplashrc'
  'kglobalshortcutsrc'
  'speechd.conf'
  'zshrc'
  'starship.toml'
  'mimos-preparar-atajos'
  'mimos-preparar-atajos-autostart.desktop'
  'mimos-preparar-tactil'
  'mimos-preparar-tactil-autostart.desktop'
  'mimos-preparar-bateria'
  'mimos-preparar-bateria-autostart.desktop'
  'ghostty-theme-claro'
  'ghostty-theme-oscuro'
  'ghostty-config'
  'sddm-theme.conf.user'
  '20-mimos-theme.conf'
