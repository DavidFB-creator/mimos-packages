  'mimos-wordmark-2000.png'
  'primer-abrazo.svg'
  'primer-abrazo.png'
  'login-abrazo.svg'
  'login-abrazo.png'
  'fastfetch-config.jsonc'
  'mimos-fastfetch-heart.txt'
  'palette.json'
  'mimos-claro.colors'
  'mimos-oscuro.colors'
  'mimos-nocturnos.colors'
  'kdeglobals'
  'speechd.conf'
  'sddm-theme.conf.user'
  '20-mimos-theme.conf'
  'LICENSE'
)
