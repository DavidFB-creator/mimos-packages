# MimOS defaults for Ghostty.
# Generated by scripts/generate-terminal-theme.py. Installed to /etc/skel so
# a new account starts here; everything below is the user's to change.

# Follow the desktop. Ghostty picks the light or dark theme from the system
# preference, so switching MimOS Claro and Oscuro takes the terminal with it
# -- which the Plasma colour scheme alone cannot do for a GPU terminal that
# does not read KConfig.
theme = light:MimOS Claro,dark:MimOS Oscuro

# JetBrains Mono, patched with the Nerd Font glyphs the prompt uses. Named
# explicitly rather than left to fontconfig, because the prompt's branch
# glyph lives in a private-use range that only a patched font carries and
# the fallback does not reliably reach it -- watched happen on real
# hardware. David chose this face on 2026-08-07 from three rendered side by
# side. Cost, measured: 228 MiB installed, 10.66 MiB into the image.
font-family = JetBrainsMono Nerd Font Mono
font-size = 12

# A window with room for the greeting and for real work. The default 80x24
# is a teletype's shape, and the MimOS greeting alone is 44 columns of
# emblem plus its information column, so a stock window opened onto a
# screen that had already scrolled. Ghostty clamps this to whatever the
# display can hold, so a generous value costs nothing on a small screen.
window-width = 150
window-height = 42

# Room to breathe, and a cursor that is easy to find on a laptop screen.
window-padding-x = 8
window-padding-y = 6
cursor-style = block
cursor-style-blink = false

# Copying on selection is what people expect from a terminal on Linux, and
# the middle-click paste that pairs with it is already the system behaviour.
copy-on-select = clipboard

# Confirm before closing a window that still has something running, because
# a terminal that vanishes with a build inside it is a bad afternoon.
confirm-close-surface = true
