// MimOS Fastfetch configuration (Nerd Font icons).
// Generated by scripts/generate-fastfetch-config.py from
// packages/mimos-branding/palette.json. Do not edit by hand;
// edit the palette or the generator, or make check will fail.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/mimos/branding/mimos-fastfetch-heart.txt",
    "color": {
      "1": "#FF6FAE",
      "2": "#7C5CFC",
      "3": "#221B3A"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#FF6FAE",
      "title": "#7C5CFC",
      "output": "default",
      "separator": "#7C5CFC"
    },
    "brightColor": true
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────",
      "outputColor": "#7C5CFC"
    },
    {
      "type": "os",
      "key": "  Sistema"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "de",
      "key": "  Escritorio"
    },
    {
      "type": "uptime",
      "key": "  Activo"
    },
    {
      "type": "packages",
      "key": "  Paquetes"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "memory",
      "key": "  Memoria"
    },
    {
      "type": "disk",
      "key": "  Disco",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "  Batería"
    },
    "break",
    {
      "type": "custom",
      "format": "{##FF6FAE}████{#}  {##7C5CFC}████{#}  {##70D6C5}████{#}  {##F8F4FF}████{#}  {##221B3A}████{#}"
    }
  ]
}
