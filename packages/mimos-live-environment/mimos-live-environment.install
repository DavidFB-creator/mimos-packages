# shellcheck shell=bash
# pacman sources this scriptlet; it has no shebang by design.

_mimos_restore_installed_boot() {
  local kernel_source kernel_bytes copied_bytes
  local -a kernel_sources

  mapfile -t kernel_sources < <(
    find /usr/lib/modules -mindepth 2 -maxdepth 2 -type f -name vmlinuz -print
  )
  if (( ${#kernel_sources[@]} != 1 )); then
    printf 'Expected exactly one installed kernel image, found %d.\n' \
      "${#kernel_sources[@]}" >&2
    return 1
  fi
  kernel_source="${kernel_sources[0]}"
  kernel_bytes="$(stat -c %s "${kernel_source}")" || return 1

  install -d -m755 /boot || return 1
  if [[ "$(stat -f -c %T /boot)" == 'btrfs' ]]; then
    # A shared Btrfs extent makes GRUB reject the kernel, so /boot must be
    # NOCOW before the bytes are streamed into a fresh extent.
    chattr +C /boot || return 1
  fi

  # pacman does not run install scriptlets under `set -e`. Without the checks
  # below, a partial write would still be followed by the preset replacement
  # and Calamares would build an initramfs around a truncated kernel, which
  # only surfaces as an unbootable system at first reboot.
  : > /boot/vmlinuz-linux || return 1
  if ! cat "${kernel_source}" > /boot/vmlinuz-linux; then
    printf 'Failed to copy %s into /boot/vmlinuz-linux.\n' "${kernel_source}" >&2
    rm -f /boot/vmlinuz-linux
    return 1
  fi
  chmod 0644 /boot/vmlinuz-linux || return 1

  copied_bytes="$(stat -c %s /boot/vmlinuz-linux)" || return 1
  if [[ "${copied_bytes}" != "${kernel_bytes}" ]]; then
    printf 'Copied kernel is %s bytes but the source is %s bytes.\n' \
      "${copied_bytes}" "${kernel_bytes}" >&2
    rm -f /boot/vmlinuz-linux
    return 1
  fi
  if ! cmp -s "${kernel_source}" /boot/vmlinuz-linux; then
    printf 'Copied kernel does not match %s.\n' "${kernel_source}" >&2
    rm -f /boot/vmlinuz-linux
    return 1
  fi

  # The destructive preset change happens only after a verified kernel exists.
  install -Dm644 /usr/share/mimos/live-environment/linux.preset \
    /etc/mkinitcpio.d/linux.preset || return 1
  rm -f /etc/mkinitcpio.conf.d/archiso.conf || return 1
}

_mimos_remove_console_autologin() {
  # Archiso's releng profile logs tty1 in as root with no password, which is
  # right for a Live image and catastrophic on a disk. The override lives in
  # the airootfs, and Calamares copies the airootfs to the target, so it
  # survived every installation MimOS has ever made: pressing Ctrl+Alt+F2 on
  # an installed machine reached a root shell without being asked for
  # anything.
  #
  # The installed audit was checking that root's *password* is locked, and it
  # was -- `passwd -S root` says L on every one of those machines. agetty
  # --autologin does not authenticate, so the lock it was proving was beside
  # the door that was open. See ADR-115.
  #
  # This package already owns every removable passwordless-session artifact;
  # this is one, and it is the only one that could not be removed by owning a
  # file, because the file belongs to Archiso rather than to us.
  local override='/etc/systemd/system/getty@tty1.service.d/autologin.conf'
  local directory="${override%/*}"

  rm -f "${override}" || return 1
  # Only if we emptied it. A user or another package may have put something
  # else there, and this is a transition, not a cleanup crew.
  rmdir "${directory}" 2>/dev/null || true
  if [[ -e "${override}" ]]; then
    printf 'mimos-live-environment: %s survived removal.\n' "${override}" >&2
    return 1
  fi
}

pre_remove() {
  if ! _mimos_restore_installed_boot; then
    printf 'mimos-live-environment: refusing to complete the installed-system transition.\n' >&2
    return 1
  fi
  if ! _mimos_remove_console_autologin; then
    printf 'mimos-live-environment: refusing to leave a passwordless root console on the installed system.\n' >&2
    return 1
  fi
}
