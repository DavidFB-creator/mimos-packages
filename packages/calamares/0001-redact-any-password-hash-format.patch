+/** @brief Is @p item a modular crypt format password hash?
+ *
+ * Modular crypt format is "$<id>$<parameters and salt>$<hash>". The identifier
+ * is whichever algorithm libxcrypt's crypt_gensalt() selected, so it must not
+ * be enumerated here: current distributions default to yescrypt ("$y$") rather
+ * than SHA-512 ("$6$").
+ */
+static bool
+isModularCryptHash( const QString& item )
+{
+    if ( !item.startsWith( '$' ) )
+    {
+        return false;
+    }
+    const int idEnd = item.indexOf( '$', 1 );
+    if ( idEnd < 2 )
+    {
+        return false;
+    }
+    return item.indexOf( '$', idEnd + 1 ) > idEnd;
+}
