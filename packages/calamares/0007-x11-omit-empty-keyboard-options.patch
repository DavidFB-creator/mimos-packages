Do not write X11 keyboard options that have no value.

systemd-localed parses /etc/X11/xorg.conf.d/00-keyboard.conf and
discards the file entirely if any Option carries an empty value. A
layout without a variant -- Spanish, among many others -- therefore
produced a file whose XkbLayout was correct and whose effect was
nothing: localectl reported X11 Layout: (unset) and the graphical
session fell back to us while the console was correct.

Measured against systemd 261: the same file with the empty
Option "XkbVariant" "" line removed reports the layout correctly,
and an empty XkbOptions or XkbModel breaks it in the same way, so the
trigger is the empty value rather than any particular key.

Generated by scripts/generate-keyboard-x11-patch.py -- edit that
script rather than this file.

--- a/src/modules/keyboard/SetKeyboardLayoutJob.cpp
+++ b/src/modules/keyboard/SetKeyboardLayoutJob.cpp
@@ -279,13 +279,26 @@
               "        MatchIsKeyboard \"on\"\n";
 
 
+    // systemd-localed discards this entire file when any option carries an
+    // empty value: a file whose XkbLayout is correct but which also says
+    // Option "XkbVariant" "" leaves localectl reporting X11 Layout: (unset),
+    // and the graphical session falls back to the us layout. A layout with no
+    // variant therefore has to omit the line rather than write it empty.
+    const auto writeOption = [ &stream ]( const char* name, const QString& value )
+    {
+        if ( !value.isEmpty() )
+        {
+            stream << "        Option \"" << name << "\" \"" << value << "\"\n";
+        }
+    };
+
     const QStringList layouts = removeEmpty( { m_additionalLayoutInfo.additionalLayout, m_layout } );
     const QStringList variants = removeEmpty( { m_additionalLayoutInfo.additionalVariant, m_variant } );
-    stream << "        Option \"XkbLayout\" \"" << layouts.join( "," ) << "\"\n";
-    stream << "        Option \"XkbVariant\" \"" << variants.join( "," ) << "\"\n";
+    writeOption( "XkbLayout", layouts.join( "," ) );
+    writeOption( "XkbVariant", variants.join( "," ) );
     if ( !m_additionalLayoutInfo.additionalLayout.isEmpty() )
     {
-        stream << "        Option \"XkbOptions\" \"" << m_additionalLayoutInfo.groupSwitcher << "\"\n";
+        writeOption( "XkbOptions", m_additionalLayoutInfo.groupSwitcher );
     }
 
     stream << "EndSection\n";
