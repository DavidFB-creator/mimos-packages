pkgname=calamares
pkgver=3.4.2
pkgrel=8
pkgdesc='Distribution-independent system installer framework'
arch=('x86_64')
url='https://calamares.io/'
license=('GPL-3.0-or-later')
depends=(
  'hicolor-icon-theme'
  'kcoreaddons'
  'kcrash'
  'kpmcore'
  'libpwquality'
  'parted'
  'python'
  'python-toml'
  'qt6-declarative'
  'qt6-svg'
  'yaml-cpp'
)
makedepends=(
  'extra-cmake-modules'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
)
options=('!debug')
source=(
  "calamares-${pkgver}.tar.gz::https://codeberg.org/Calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
  "calamares-${pkgver}.signature::https://codeberg.org/Calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz.asc"
  'calamares-maintainer-2026.key::https://euroquis.nl/doc/pubkey.asc'
  '0001-redact-any-password-hash-format.patch'
  '0002-users-accessible-names.patch'
  '0003-users-password-row-scaling.patch'
  '0004-sidebar-logo-aspect.patch'
  '0005-users-scrollable-page.patch'
  '0006-users-stack-password-fields.patch'
  '0007-x11-omit-empty-keyboard-options.patch'
  'check-accessible-translations.py'
)
