// Generated by scripts/generate-plymouth-theme.py from
// packages/mimos-branding/palette.json (mimos-oscuro). Do not edit by
// hand; edit the palette and regenerate, or make check will fail.

Window.SetBackgroundTopColor(0.1333, 0.1059, 0.2275);
Window.SetBackgroundBottomColor(0.1725, 0.1412, 0.2667);

mimi.image = Image("mimi-boot.png");
mimi.sprite = Sprite(mimi.image);
mimi.x = Window.GetX() + Window.GetWidth() / 2 - mimi.image.GetWidth() / 2;
mimi.y = Window.GetY() + Window.GetHeight() / 2 - mimi.image.GetHeight() / 2;
mimi.sprite.SetPosition(mimi.x, mimi.y, 10);

// MIMI breathes while the system boots, the same cue as the session
// splash: opacity swings gently instead of scale, because the script
// plugin rescales by resampling the image every frame.
progress = 0;
fun refresh_callback() {
    progress++;
    opacity = 0.85 + 0.15 * Math.Sin(progress / 25);
    mimi.sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- Messages (fsck progress, boot messages) --------------------------
message.sprite = Sprite();
message.sprite.SetPosition(
    Window.GetX() + Window.GetWidth() * 0.5,
    Window.GetY() + Window.GetHeight() * 0.9, 20);

fun message_callback(text) {
    message.image = Image.Text(text, 0.9725, 0.9569, 1.0);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2,
        Window.GetY() + Window.GetHeight() * 0.9, 20);
}
Plymouth.SetMessageFunction(message_callback);

// ---- Passphrase dialogue ----------------------------------------------
// An encrypted system whose keyfile cannot answer asks here. The prompt
// and one bullet per typed character render under MIMI; hiding them on
// display-normal returns to the plain splash.
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}

fun display_password_callback(prompt_text, bullet_count) {
    if (prompt_text == "")
        prompt_text = "Contraseña de cifrado";
    prompt.image = Image.Text(prompt_text, 0.9725, 0.9569, 1.0);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - prompt.image.GetWidth() / 2,
        mimi.y + mimi.image.GetHeight() + 40, 30);
    prompt.sprite.SetOpacity(1);

    bullet_text = "";
    for (i = 0; i < bullet_count; i++)
        bullet_text += "*";
    if (bullet_text == "")
        bullet_text = " ";
    bullets.image = Image.Text(bullet_text, 0.702, 0.6353, 1.0);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - bullets.image.GetWidth() / 2,
        mimi.y + mimi.image.GetHeight() + 80, 30);
    bullets.sprite.SetOpacity(1);
}

fun display_question_callback(prompt_text, entry_text) {
    display_password_callback(prompt_text, 0);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
