#!/usr/bin/env bash
set -Eeuo pipefail

window='/usr/share/mimos/welcome-live/Window.qml'
release_file='/etc/mimos-release'
# The Live session ships MimOS Claro, so its wallpaper is the claro
# Arrumaco. Forcing it here rather than trusting the containment restore is
# the same retry loop primer-abrazo needed; only the file changed (ADR-093).
wallpaper='/usr/share/backgrounds/mimos/arrumaco-claro.png'
live_marker='/usr/lib/mimos/live-environment'
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/mimos"
autostart=false

show_error() {
  local message="$1"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title 'Centro de MimOS' --error "${message}" || true
  else
    printf '%s\n' "${message}" >&2
  fi
}

case "${1:-}" in
  '')
    ;;
  --autostart)
    autostart=true
    ;;
  *)
    printf 'Usage: %s [--autostart]\n' "$0" >&2
    exit 2
    ;;
esac

# Fail closed: this application exists only for the Live session. Calamares
# removes the package at installation, but if these bytes ever reach an
# installed system anyway, they refuse to run rather than impersonate the
# installed Centro (ADR-093).
if ! [[ -f "${live_marker}" && ! -L "${live_marker}" ]] || \
  [[ "$(stat -c '%u:%g:%a' "${live_marker}")" != '0:0:644' ]]; then
  show_error 'Este Centro de MimOS solo funciona en la sesión Live.'
  exit 1
fi

if [[ ! -f "${window}" ]]; then
  show_error 'No se encuentra la interfaz de Centro de MimOS.'
  exit 1
fi

version_id='development'
if [[ -f "${release_file}" ]]; then
  detected_version="$(sed -n 's/^VERSION_ID="\(.*\)"/\1/p' "${release_file}")"
  [[ -n "${detected_version}" ]] && version_id="${detected_version}"
fi
marker="${state_dir}/welcome-live-${version_id}"

mkdir -p -- "${state_dir}"

if [[ "${autostart}" == true && -e "${marker}" ]]; then
  exit 0
fi

# The brand wallpaper must not depend on the user closing this window.
#
# The previous owner of this loop called plasma-apply-wallpaperimage once
# before the window opened and once after it closed. On autostart the first
# call lands while Plasma is still restoring its containment and fails, and
# the second never runs while the window stays open, so the Live session
# showed the stock Plasma wallpaper for as long as Centro de MimOS was on
# screen. Both calls ended in `|| true`, so nothing reported it.
#
# This retries in the background with a bounded budget and gives up quietly.
# It never blocks the interface and never fails the session.
apply_wallpaper() {
  local attempt
  local plasma_config="${XDG_CONFIG_HOME:-${HOME}/.config}/plasma-org.kde.plasma.desktop-appletsrc"
  if ! command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    return 0
  fi
  if [[ ! -f "${wallpaper}" ]]; then
    return 0
  fi
  for ((attempt = 0; attempt < 20; attempt++)); do
    # Plasma may return success before its containment exists. Success from the
    # helper is therefore not evidence that the desktop accepted the change.
    # Retry until Plasma's own configuration records the exact packaged file.
    plasma-apply-wallpaperimage "${wallpaper}" >/dev/null 2>&1 || true
    sleep 1
    if grep -Fq "Image=file://${wallpaper}" "${plasma_config}" 2>/dev/null; then
      return 0
    fi
  done
  return 0
}

# The window follows the session theme; the Live session ships MimOS Claro by
# default, and the launcher reads the session's ColorScheme so a user who
# switches to Oscuro gets a matching window (ADR-093).
detect_appearance() {
  local kdeglobals="${XDG_CONFIG_HOME:-${HOME}/.config}/kdeglobals"
  local scheme=''
  if [[ -f "${kdeglobals}" ]]; then
    scheme="$(sed -n 's/^ColorScheme=//p' "${kdeglobals}" | head -n 1)"
  fi
  case "${scheme}" in
    *[Oo]scur*|*[Nn]octurn*|*[Dd]ark*|*[Bb]reeze[Dd]ark*)
      printf 'oscuro'
      ;;
    *)
      printf 'claro'
      ;;
  esac
}

# The compiled runner owns the window's identity: the generic qml6 tool
# declares desktopFileName org.qt-project.qml and its own Qr icon over the
# Wayland toplevel-icon protocol, which no desktop file or KWin rule could
# override (ADR-093).
runner='/usr/lib/mimos/centro-mimos-live'
if [[ ! -x "${runner}" ]]; then
  show_error 'El entorno de Centro de MimOS no está disponible.'
  exit 1
fi

# Runs alongside the window rather than around it, so the wallpaper appears
# whether or not the user ever opens or closes Centro de MimOS.
apply_wallpaper &
wallpaper_pid=$!

export QT_QUICK_CONTROLS_STYLE='Basic'

appearance="$(detect_appearance)"

set +e
"${runner}" '--mimos-context=live' "--mimos-appearance=${appearance}"
status=$?
set -e

if [[ "${autostart}" == true ]]; then
  touch -- "${marker}"
fi

wait "${wallpaper_pid}" 2>/dev/null || true

case "${status}" in
  0)
    exit 0
    ;;
  10)
    # Second, independent gate before anything destructive becomes reachable:
    # the marker must still be valid now, not merely at launch.
    if ! [[ -f "${live_marker}" && ! -L "${live_marker}" ]] || \
      [[ "$(stat -c '%u:%g:%a' "${live_marker}")" != '0:0:644' ]]; then
      show_error 'El instalador solo está disponible desde el entorno Live.'
      exit 1
    fi
    if [[ -x /usr/bin/mimos-installer ]]; then
      /usr/bin/mimos-installer >/dev/null 2>&1 &
      exit 0
    fi
    show_error 'MimOS Installer todavía no está disponible.'
    exit 1
    ;;
  11|12|13)
    show_error 'Esa acción solo está disponible en el sistema instalado.'
    exit 1
    ;;
  *)
    printf 'Centro de MimOS exited with status %s.\n' "${status}" >&2
    exit "${status}"
    ;;
esac
