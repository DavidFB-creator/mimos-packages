# Maintainer: XI14 <https://github.com/DavidFB-creator/MimOS>

pkgname=mimos-welcome-live
pkgver=1.0.1
pkgrel=1
pkgdesc='Centro de MimOS for the Live session: welcome, install and community'
# Compiled since the runner exists: the generic qml6 tool declares its own
# window identity (org.qt-project.qml, the Qr icon) and KWin honours the
# window over any desktop file, so the identity must be owned in C++.
arch=('x86_64')
# No debug split: the host makepkg.conf would otherwise emit a -debug
# package and the ephemeral repository's package count is exact.
options=('!debug')
url='https://github.com/DavidFB-creator/MimOS'
license=('MIT')
# gettext for the launcher's strings (ADR-159); qt6-tools and gettext at
# build time compile the Catalan catalogues from the sources beside them.
depends=('bash' 'gettext' 'qt6-declarative' 'mimos-branding')
makedepends=('gcc' 'pkgconf' 'qt6-tools' 'gettext')
optdepends=(
  'kdialog: show graphical error messages'
  'mimos-installer: launch MimOS Installer'
  'mimos-release: version-aware autostart'
  'plasma-workspace: apply the MimOS wallpaper'
)
source=(
  'mimos-welcome-live'
  'Main.qml'
  'Window.qml'
  'mimos-welcome-live-autostart.desktop'
  'centro-main.cpp'
  'centro-live_ca.ts'
  'mimos-welcome-live.ca.po'
  'LICENSE'
)
sha256sums=('44b5976cfd4c59930da39bc595efadf3b8d212150f4d4882872d9619fabc2b0a'
            '0bd1640da90d348764d0341c1d2b41a2301329215925e6a481f6594c5031e676'
            'b735e57e318376a7e50c6e3d7e42d8b9e6457cb4dfe9ca0503e72364f40288cd'
            '2ece71da7e3143fbe7166f87ae29a526bae95d54a83adff3fdbb97b5111e334e'
            '0949e2ce9015cbdab00d2e26fa11b0de8b812c8b65666b097262b957b653b94a'
            '3487d36cde188a6d06122d6a509a703ad5c6d5bbca3753acf816f9cc5f6886a6'
            '0f27b2ae8a11161b9b80942ad6d10dd6f63e76f363aa2456557775d3471fbbff'
            '97d7ba0977ea88730c942625f66849bbef6536c3c6e103a39a4bb05b9fd3d9cf')

build() {
  g++ -std=c++17 -fPIC ${CXXFLAGS} centro-main.cpp \
    -DCENTRO_WINDOW_QML='"/usr/share/mimos/welcome-live/Window.qml"' \
    -DTRADUCCIONES_DIR='"/usr/share/mimos/translations"' \
    $(pkg-config --cflags --libs Qt6Qml Qt6Gui Qt6Core) \
    ${LDFLAGS} -o centro-mimos-live
  /usr/lib/qt6/bin/lrelease -silent centro-live_ca.ts -qm centro-live_ca.qm
  msgfmt --check --output-file mimos-welcome-live.mo mimos-welcome-live.ca.po
}

package() {
  install -Dm755 mimos-welcome-live "${pkgdir}/usr/bin/mimos-welcome-live"
  install -Dm755 centro-mimos-live \
    "${pkgdir}/usr/lib/mimos/centro-mimos-live"
  install -Dm644 Main.qml "${pkgdir}/usr/share/mimos/welcome-live/Main.qml"
  install -Dm644 Window.qml \
    "${pkgdir}/usr/share/mimos/welcome-live/Window.qml"
  # No menu entry on purpose: mimos-welcome's entry delegates here in a Live
  # session, so the menu carries exactly one "Centro de MimOS" (ADR-093).
  install -Dm644 mimos-welcome-live-autostart.desktop \
    "${pkgdir}/etc/xdg/autostart/mimos-welcome-live.desktop"
  install -Dm644 centro-live_ca.qm "${pkgdir}/usr/share/mimos/translations/centro-live_ca.qm"
  install -Dm644 mimos-welcome-live.mo \
    "${pkgdir}/usr/share/locale/ca/LC_MESSAGES/mimos-welcome-live.mo"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
